{%- comment -%}
  Artpixe · FAQ.
  Si le produit a le métachamp artpixe.faq (liste de { q, a }), il est affiché tel quel :
  son balisage FAQPage est déjà produit par snippets/artpixe-seo-schema.liquid, donc rien n'est ajouté ici.
  Sinon, les questions viennent des blocs et le balisage FAQPage est généré à partir du même contenu.
  Le texte affiché et le balisage ne peuvent donc jamais diverger.
{%- endcomment -%}
{{ 'apx-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign mf_faq = product.metafields.artpixe.faq.value
  assign use_mf = false
  if section.settings.use_metafield and mf_faq != blank and mf_faq.size > 0
    assign use_mf = true
  endif
-%}

<div class="apx-scope apx-sec" id="{{ section.settings.anchor | default: 'faq' | handle }}">
  <div class="apx-sec__inner apx-sec__inner--narrow">
    <header class="apx-sec__head">
      {%- if section.settings.heading != blank -%}<h2 class="apx-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    </header>
    <div class="apx-faq">
      {%- if use_mf -%}
        {%- for item in mf_faq -%}
          <details class="apx-faq__item" {% if forloop.first and section.settings.open_first %}open{% endif %}>
            <summary><h3 class="apx-faq__q">{{ item.q }}</h3></summary>
            <div class="apx-rte">{{ item.a }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <details
            class="apx-faq__item"
            {{ block.shopify_attributes }}
            {% if forloop.first and section.settings.open_first %}open{% endif %}
          >
            <summary><h3 class="apx-faq__q">{{ block.settings.question }}</h3></summary>
            <div class="apx-rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{%- if use_mf == false and section.settings.emit_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | strip | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Artpixe · FAQ",
  "tag": "section",
  "class": "apx-section",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre (H2)", "default": "Tes questions" },
    { "type": "text", "id": "anchor", "label": "Ancre", "default": "faq" },
    { "type": "checkbox", "id": "open_first", "label": "Première question ouverte", "default": true },
    {
      "type": "checkbox",
      "id": "use_metafield",
      "label": "Utiliser la FAQ du produit (métachamp artpixe.faq) si elle existe",
      "default": true,
      "info": "Permet une FAQ différente par univers avec un seul template."
    },
    {
      "type": "checkbox",
      "id": "emit_schema",
      "label": "Générer le balisage FAQPage pour les questions des blocs",
      "default": true,
      "info": "Ignoré quand le métachamp est utilisé : le thème le génère déjà."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question (H3)", "default": "Est-ce que ça va vraiment me ressembler ?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Le graphiste dessine à partir de ta photo, puis tu reçois un aperçu avant toute impression. Tant que tu n'as pas validé, on retouche.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Artpixe · FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
