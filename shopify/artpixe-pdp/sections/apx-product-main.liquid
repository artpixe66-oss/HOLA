{%- comment -%}
  Artpixe · Fiche produit personnalisée · section principale
  Galerie, zone d'achat, configurateur en étapes et barre fixe mobile.
  Le formulaire ne contient que la variante : les champs, boutons et blocs d'applications
  s'y rattachent par l'attribut form, ce qui évite les formulaires imbriqués.
{%- endcomment -%}
<script>document.documentElement.classList.add('apx-js');</script>
{{ 'apx-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'apx-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign form_id = 'apx-form-' | append: section.id
  assign url_variant = product.selected_variant
  assign current_variant = product.selected_or_first_available_variant
  assign default_value = section.settings.default_option_value | strip
  if url_variant == blank and default_value != blank
    for v in product.variants
      if v.available and v.options contains default_value
        assign current_variant = v
        break
      endif
    endfor
  endif

  assign ratio_class = 'apx-ratio--' | append: section.settings.image_ratio
-%}

{%- style -%}
  :root {
    {%- if section.settings.color_accent != blank %}--apx-c-accent: {{ section.settings.color_accent }};{% endif %}
    {%- if section.settings.color_bg != blank %}--apx-c-bg: {{ section.settings.color_bg }};{% endif %}
    {%- if section.settings.color_text != blank %}--apx-c-fg: {{ section.settings.color_text }};{% endif %}
  }
{%- endstyle -%}

<div
  class="apx-scope apx-main"
  data-apx-root
  data-section-id="{{ section.id }}"
>
  <script type="application/json" data-apx-json>
    {
      "formId": {{ form_id | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "updateUrl": {{ section.settings.update_url | json }},
      "productUrl": {{ product.url | json }},
      "currentVariantId": {{ current_variant.id | json }},
      "variants": [
        {%- for v in product.variants -%}
          {"id": {{ v.id }}, "options": {{ v.options | json }}, "price": {{ v.price }}, "compare": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available | json }}, "media": {{ v.featured_media.id | default: 0 }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

  <div class="apx-main__grid">
    {%- comment -%} Galerie {%- endcomment -%}
    <div class="apx-gallery {{ ratio_class }}" data-apx-gallery>
      <ul class="apx-gallery__track" data-apx-track aria-label="Images de {{ product.title | escape }}">
        {%- for media in product.media -%}
          {%- liquid
            assign media_alt = media.alt | default: product.title
            if forloop.first
              assign img_loading = 'eager'
              assign img_priority = 'high'
            else
              assign img_loading = 'lazy'
              assign img_priority = 'auto'
            endif
          -%}
          <li
            class="apx-gallery__slide"
            id="apx-slide-{{ section.id }}-{{ media.id }}"
            data-media-id="{{ media.id }}"
          >
            {%- if media.media_type == 'image' -%}
              {{
                media
                | image_url: width: 1400
                | image_tag:
                  loading: img_loading,
                  fetchpriority: img_priority,
                  widths: '360, 540, 720, 900, 1100, 1400',
                  sizes: '(min-width: 990px) 55vw, 100vw',
                  alt: media_alt,
                  class: 'apx-gallery__img'
              }}
            {%- else -%}
              <div class="apx-gallery__media">{{ media | media_tag: image_size: '1100x' }}</div>
            {%- endif -%}
          </li>
        {%- else -%}
          <li class="apx-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'apx-gallery__img' }}</li>
        {%- endfor -%}
      </ul>

      {%- if product.media.size > 1 -%}
        <p class="apx-gallery__count" aria-hidden="true">
          <span data-apx-slide-index>1</span> / {{ product.media.size }}
        </p>
        {%- if section.settings.show_thumbnails -%}
          <ul class="apx-gallery__thumbs" aria-label="Choisir une image">
            {%- for media in product.media -%}
              <li>
                <button
                  type="button"
                  class="apx-gallery__thumb"
                  data-apx-thumb="{{ media.id }}"
                  aria-label="Voir l'image {{ forloop.index }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                >
                  {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- comment -%} Zone d'achat {%- endcomment -%}
    <div class="apx-buy" id="apx-buy-{{ section.id }}">
      {%- form 'product', product, id: form_id, class: 'apx-form', data-apx-form: '' -%}
        <select name="id" class="apx-variant-select" aria-label="Variante" data-apx-variant-select>
          {%- for v in product.variants -%}
            <option
              value="{{ v.id }}"
              {% if v.id == current_variant.id %}selected{% endif %}
              {% unless v.available %}disabled{% endunless %}
            >
              {{ v.title | escape }} · {{ v.price | money_with_currency | strip_html }}
            </option>
          {%- endfor -%}
        </select>
        {%- if section.settings.after_add == 'checkout' -%}
          <input type="hidden" name="return_to" value="{{ routes.root_url | append: '/checkout' | replace: '//', '/' }}">
        {%- endif -%}
      {%- endform -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="apx-app">{% render block %}</div>

          {%- when 'title' -%}
            <h1 class="apx-title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'subtitle' -%}
            {%- if block.settings.text != blank -%}
              <p class="apx-subtitle" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}

          {%- when 'rating' -%}
            {%- liquid
              assign r_avg = product.metafields.loox.avg_rating.value
              assign r_count = product.metafields.loox.num_reviews.value
              if r_count == blank or r_count == 0
                assign r_avg = product.metafields.reviews.rating.value.rating
                assign r_count = product.metafields.reviews.rating_count.value
              endif
            -%}
            {%- if r_count > 0 -%}
              <a class="apx-rating" href="#{{ block.settings.anchor | default: 'avis' | handle }}" {{ block.shopify_attributes }}>
                <span class="apx-stars" style="--apx-rating: {{ r_avg }};" aria-hidden="true"></span>
                <span>
                  <strong>{{ r_avg | round: 1 | replace: '.', ',' }}/5</strong>
                  · {{ r_count }}
                  {{ block.settings.label }}
                </span>
              </a>
            {%- endif -%}

          {%- when 'price' -%}
            {%- liquid
              assign ctx = block.settings.context | default: ''
              assign ctx = ctx | replace: '[1]', current_variant.option1 | replace: '[2]', current_variant.option2 | replace: '[3]', current_variant.option3
            -%}
            <div class="apx-price" {{ block.shopify_attributes }}>
              <span class="apx-price__now" data-apx-price>{{ current_variant.price | money }}</span>
              <s
                class="apx-price__was"
                data-apx-compare
                {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
                >{{- current_variant.compare_at_price | money -}}</s
              >
              {%- if ctx != blank -%}
                <span
                  class="apx-price__ctx"
                  data-apx-price-context="{{ block.settings.context | escape }}"
                  >{{ ctx }}</span
                >
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <span class="apx-price__note">{{ block.settings.note }}</span>
              {%- endif -%}
            </div>

          {%- when 'reassurance' -%}
            <ul class="apx-reassurance" {{ block.shopify_attributes }}>
              {%- if block.settings.item_1 != blank %}<li>{{ block.settings.item_1 }}</li>{% endif -%}
              {%- if block.settings.item_2 != blank %}<li>{{ block.settings.item_2 }}</li>{% endif -%}
              {%- if block.settings.item_3 != blank %}<li>{{ block.settings.item_3 }}</li>{% endif -%}
            </ul>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div
                class="apx-picker"
                id="apx-config"
                data-apx-picker
                data-chips-price="{{ block.settings.chips_price }}"
                data-cards-price="{{ block.settings.cards_price }}"
                {{ block.shopify_attributes }}
              >
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign opt_index0 = forloop.index0
                    assign opt_index = forloop.index
                    assign heading_key = 'heading_' | append: opt_index
                    assign hint_key = 'hint_' | append: opt_index
                    assign heading = block.settings[heading_key] | default: option.name
                    assign cur_val = current_variant.options[opt_index0]
                    assign is_card = false
                    if option.name == block.settings.card_option_name
                      assign is_card = true
                    endif
                    assign base_price = nil
                  -%}
                  {%- if option.values.size > 1 -%}
                    <fieldset
                      class="apx-step apx-option {% if is_card %}apx-option--cards{% else %}apx-option--chips{% endif %}"
                      data-apx-option="{{ opt_index0 }}"
                    >
                      <legend class="apx-step__title">
                        <span class="apx-step__num" aria-hidden="true"></span>{{ heading }}
                      </legend>
                      {%- if block.settings[hint_key] != blank -%}
                        <p class="apx-hint">{{ block.settings[hint_key] }}</p>
                      {%- endif -%}
                      <div class="apx-option__values">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign value_index0 = forloop.index0
                            assign value_name = value.name | default: value
                            assign input_id = 'apx-' | append: section.id | append: '-o' | append: opt_index | append: '-' | append: forloop.index

                            assign match = nil
                            for v in product.variants
                              assign ok = true
                              for o in v.options
                                if forloop.index0 == opt_index0
                                  if o != value_name
                                    assign ok = false
                                  endif
                                elsif o != current_variant.options[forloop.index0]
                                  assign ok = false
                                endif
                              endfor
                              if ok
                                assign match = v
                                break
                              endif
                            endfor
                            if value_index0 == 0 and match
                              assign base_price = match.price
                            endif

                            assign card_label = value_name
                            assign card_desc = ''
                            assign card_badge = ''
                            for b in section.blocks
                              if b.type == 'option_card' and b.settings.value == value_name
                                assign card_label = b.settings.label | default: value_name
                                assign card_desc = b.settings.description
                                assign card_badge = b.settings.badge
                                break
                              endif
                            endfor
                          -%}
                          <div class="apx-val">
                            <input
                              type="radio"
                              class="apx-val__input"
                              id="{{ input_id }}"
                              name="apx-{{ section.id }}-o{{ opt_index }}"
                              value="{{ value_name | escape }}"
                              data-apx-value
                              {% if value_name == cur_val %}checked{% endif %}
                              {% unless match and match.available %}data-unavailable{% endunless %}
                            >
                            <label class="apx-val__label" for="{{ input_id }}">
                              {%- if is_card and card_badge != blank -%}
                                <span class="apx-val__badge">{{ card_badge }}</span>
                              {%- endif -%}
                              <span class="apx-val__name">{{ card_label }}</span>
                              {%- if is_card and card_desc != blank -%}
                                <span class="apx-val__desc">{{ card_desc }}</span>
                              {%- endif -%}
                              <span class="apx-val__price" data-apx-value-price>
                                {%- if match -%}
                                  {%- if is_card -%}
                                    {%- if block.settings.cards_price -%}{{ match.price | money }}{%- endif -%}
                                  {%- elsif block.settings.chips_price == 'absolute' -%}
                                    {{ match.price | money }}
                                  {%- elsif block.settings.chips_price == 'delta' and base_price -%}
                                    {%- assign delta = match.price | minus: base_price -%}
                                    {%- if delta > 0 -%}+{{ delta | money }}{%- endif -%}
                                  {%- endif -%}
                                {%- endif -%}
                              </span>
                            </label>
                          </div>
                        {%- endfor -%}
                      </div>
                      {%- if opt_index == block.settings.upsell_option and block.settings.upsell_text != blank -%}
                        <p
                          class="apx-upsell"
                          data-apx-upsell
                          data-template="{{ block.settings.upsell_text | escape }}"
                          hidden
                        ></p>
                      {%- endif -%}
                    </fieldset>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'step_heading' -%}
            <div class="apx-step apx-step--free" {{ block.shopify_attributes }}>
              <p class="apx-step__title">
                <span class="apx-step__num" aria-hidden="true"></span>{{ block.settings.heading }}
              </p>
              {%- if block.settings.hint != blank -%}
                <p class="apx-hint">{{ block.settings.hint }}</p>
              {%- endif -%}
            </div>

          {%- when 'text_field' -%}
            {%- liquid
              assign fid = 'apx-f-' | append: block.id
              assign prop = block.settings.property_name | default: block.settings.label | strip
            -%}
            <div class="apx-field" {{ block.shopify_attributes }}>
              <label class="apx-label" for="{{ fid }}">
                {{- block.settings.label -}}
                {%- unless block.settings.required %} <span class="apx-optional">(facultatif)</span>{% endunless -%}
              </label>
              {%- if block.settings.multiline -%}
                <textarea
                  id="{{ fid }}"
                  class="apx-input"
                  name="properties[{{ prop | escape }}]"
                  form="{{ form_id }}"
                  rows="3"
                  placeholder="{{ block.settings.placeholder | escape }}"
                  {% if block.settings.max_length > 0 %}maxlength="{{ block.settings.max_length }}"{% endif %}
                  {% if block.settings.required %}required{% endif %}
                ></textarea>
              {%- else -%}
                <input
                  id="{{ fid }}"
                  class="apx-input"
                  type="text"
                  name="properties[{{ prop | escape }}]"
                  form="{{ form_id }}"
                  placeholder="{{ block.settings.placeholder | escape }}"
                  autocomplete="off"
                  {% if block.settings.max_length > 0 %}maxlength="{{ block.settings.max_length }}"{% endif %}
                  {% if block.settings.required %}required{% endif %}
                >
              {%- endif -%}
              {%- if block.settings.help != blank -%}
                <p class="apx-hint">{{ block.settings.help }}</p>
              {%- endif -%}
            </div>

          {%- when 'choice_field' -%}
            {%- liquid
              assign prop = block.settings.property_name | default: block.settings.label | strip
              assign choices = block.settings.choices | newline_to_br | split: '<br />'
              assign default_choice = block.settings.default_choice | strip
            -%}
            <fieldset class="apx-field apx-choice" {{ block.shopify_attributes }}>
              <legend class="apx-label">{{ block.settings.label }}</legend>
              <div class="apx-option__values">
                {%- for c in choices -%}
                  {%- assign choice = c | strip -%}
                  {%- if choice != blank -%}
                    {%- assign cid = 'apx-c-' | append: block.id | append: '-' | append: forloop.index -%}
                    <div class="apx-val">
                      <input
                        type="radio"
                        class="apx-val__input"
                        id="{{ cid }}"
                        name="properties[{{ prop | escape }}]"
                        form="{{ form_id }}"
                        value="{{ choice | escape }}"
                        {% if choice == default_choice %}checked{% endif %}
                      >
                      <label class="apx-val__label" for="{{ cid }}"><span class="apx-val__name">{{ choice }}</span></label>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>

          {%- when 'photo_later' -%}
            {%- assign pid = 'apx-p-' | append: block.id -%}
            <div class="apx-field apx-check" {{ block.shopify_attributes }}>
              <input
                type="checkbox"
                id="{{ pid }}"
                name="properties[{{ block.settings.property_name | default: 'Photo' | escape }}]"
                form="{{ form_id }}"
                value="{{ block.settings.property_value | escape }}"
              >
              <label for="{{ pid }}">
                <strong>{{ block.settings.label }}</strong>
                {%- if block.settings.help != blank %}<span class="apx-hint">{{ block.settings.help }}</span>{% endif -%}
              </label>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="apx-buy-buttons" {{ block.shopify_attributes }}>
              <button
                type="submit"
                name="add"
                form="{{ form_id }}"
                class="apx-btn apx-btn--primary"
                data-apx-submit
                data-label="{{ block.settings.label | escape }}"
                data-soldout="{{ block.settings.soldout_label | escape }}"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-apx-btn-label>
                  {%- if current_variant.available -%}
                    {{- block.settings.label -}}
                  {%- else -%}
                    {{- block.settings.soldout_label -}}
                  {%- endif -%}
                </span>
                {%- if block.settings.show_price -%}
                  <span aria-hidden="true">·</span>
                  <span data-apx-price>{{ current_variant.price | money }}</span>
                {%- endif -%}
              </button>
              <p class="apx-error" role="alert" data-apx-error hidden></p>
              {%- if block.settings.microcopy != blank -%}
                <div class="apx-micro">{{ block.settings.microcopy }}</div>
              {%- endif -%}
            </div>

          {%- when 'notice' -%}
            {%- liquid
              assign now_s = 'now' | date: '%s' | plus: 0
              assign start_s = 0
              assign end_s = 0
              if block.settings.start != blank
                assign start_s = block.settings.start | date: '%s' | plus: 0
              endif
              if block.settings.end != blank
                assign end_s = block.settings.end | date: '%s' | plus: 0
              endif
              assign visible = true
              if start_s > 0 and now_s < start_s
                assign visible = false
              endif
              if end_s > 0 and now_s > end_s
                assign visible = false
              endif
            -%}
            {%- if block.settings.text != blank -%}
              <div
                class="apx-notice apx-notice--{{ block.settings.style }}"
                data-apx-dated
                data-start="{{ start_s }}"
                data-end="{{ end_s }}"
                {% if block.settings.countdown_hours > 0 and end_s > 0 %}data-countdown="{{ block.settings.countdown_hours }}"{% endif %}
                {% unless visible %}hidden{% endunless %}
                {{ block.shopify_attributes }}
              >
                <div class="apx-rte">{{ block.settings.text }}</div>
                <p class="apx-notice__countdown" data-apx-countdown hidden></p>
              </div>
            {%- endif -%}

          {%- when 'richtext' -%}
            <div class="apx-rte apx-block-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'collapsible' -%}
            <details class="apx-collapsible" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="apx-rte">{{ block.settings.text }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.sticky_enable -%}
    <div class="apx-sticky" data-apx-sticky data-mode="{{ section.settings.sticky_mode }}" hidden>
      <div class="apx-sticky__info">
        <span class="apx-sticky__title">{{ product.title | escape }}</span>
        <span class="apx-sticky__price" data-apx-price>{{ current_variant.price | money }}</span>
      </div>
      <button type="button" class="apx-btn apx-btn--primary apx-sticky__btn" data-apx-sticky-btn>
        {{- section.settings.sticky_label -}}
      </button>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.emit_schema -%}
  {%- render 'apx-product-schema', product: product, current_variant: current_variant -%}
{%- endif -%}

{% schema %}
{
  "name": "Artpixe · Fiche produit",
  "tag": "section",
  "class": "apx-section-main",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Variantes" },
    {
      "type": "text",
      "id": "default_option_value",
      "label": "Valeur présélectionnée",
      "default": "Poster A3",
      "info": "Variante choisie à l'arrivée, sauf si le lien contient déjà ?variant=. Laisser vide pour la première variante disponible."
    },
    {
      "type": "checkbox",
      "id": "update_url",
      "label": "Mettre à jour l'adresse quand le client change d'option",
      "default": true,
      "info": "Ajoute ?variant= à l'URL. L'URL canonique ne change pas."
    },
    { "type": "header", "content": "Galerie" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Format des images",
      "options": [
        { "value": "adapt", "label": "Format d'origine" },
        { "value": "square", "label": "Carré" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "show_thumbnails", "label": "Miniatures sur ordinateur", "default": true },
    { "type": "header", "content": "Après l'ajout au panier" },
    {
      "type": "select",
      "id": "after_add",
      "label": "Destination",
      "options": [
        { "value": "cart", "label": "Page panier" },
        { "value": "checkout", "label": "Paiement direct" }
      ],
      "default": "cart"
    },
    { "type": "header", "content": "Barre fixe mobile" },
    { "type": "checkbox", "id": "sticky_enable", "label": "Afficher la barre fixe", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Texte du bouton", "default": "Personnaliser" },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Action du bouton",
      "options": [
        { "value": "scroll", "label": "Remonter au configurateur" },
        { "value": "submit", "label": "Ajouter au panier si tout est rempli" }
      ],
      "default": "scroll"
    },
    { "type": "header", "content": "Référencement" },
    {
      "type": "checkbox",
      "id": "emit_schema",
      "label": "Générer les données structurées Product",
      "default": true,
      "info": "Prix, disponibilité et note réels, calculés depuis Shopify et Loox. Désactiver seulement si une application SEO en génère déjà."
    },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "color_bg", "label": "Fond", "default": "#141414" },
    { "type": "color", "id": "color_text", "label": "Texte", "default": "#f0ede8" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#f5a623" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Titre (H1)",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Affiche le titre du produit. C'est le seul H1 de la page : le modifier dans la fiche produit, pas ici." }
      ]
    },
    {
      "type": "subtitle",
      "name": "Accroche",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte",
          "default": "Un graphiste te dessine en pirate recherché, avec ton nom et ta prime. Tu vois l'aperçu avant l'impression et on retouche jusqu'à ce que ce soit vraiment toi."
        }
      ]
    },
    {
      "type": "rating",
      "name": "Note clients",
