  assign t_nav = t_nav | split: '|'

  comment
    Variante affichée : celle de l'URL, sinon le Displate, sinon la première disponible
  endcomment
  assign form_id = 'apx-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  if product.selected_variant == blank
    for v in product.variants
      if v.available and v.options contains 'Displate'
        assign current_variant = v
        break
      endif
    endfor
  endif
  assign savings = 0
  if current_variant.compare_at_price > current_variant.price
    assign savings = current_variant.compare_at_price | minus: current_variant.price
  endif

  comment
    Propriétés : One Piece (champ prime visible sur cette fiche) garde ses libellés d'affiche Wanted.
    Le bloc prime est présent dans tous les modèles, limité à One Piece par sa visibilité : on la vérifie.
  endcomment
  assign pr_collection_titles = product.collections | map: 'title'
  assign is_op = false
  for field in props
    assign h = field.settings.heading | downcase
    if h contains 'prime'
      capture prime_probe
        render 'apx-portrait-field', field: field, mode: 'probe', product: product, pr_collection_titles: pr_collection_titles
      endcapture
      if prime_probe contains 'visible'
        assign is_op = true
      endif
    endif
  endfor

  comment
    Option « nombre » : personnes, animaux ou sujets
  endcomment
  assign kind = 'people'
  if product.options.size > 1
    assign opt1 = product.options_with_values[0].name | downcase
    if opt1 contains 'sujet'
      assign kind = 'subjects'
    elsif opt1 contains 'personne'
      assign kind = 'people'
    elsif opt1 contains 'animal' or opt1 contains 'animaux'
      assign kind = 'animals'
    endif
  endif
  case kind
    when 'animals'
      assign t_opt1 = t_opt_animals
      assign t_upsell = t_up_animals
      assign t_hint_photos = t_photos_hint_animals
    when 'subjects'
      assign t_opt1 = t_opt_subjects
      assign t_upsell = t_up_subjects
      assign t_hint_photos = t_photos_hint_animals
    else
      assign t_opt1 = t_opt_people
      assign t_upsell = t_up_people
      assign t_hint_photos = t_photos_hint
  endcase
-%}

{%- comment -%} Champs de personnalisation : courts dans l'étape 3, longs après les photos {%- endcomment -%}
{%- capture fields_short -%}
  {%- for field in props -%}
    {%- render 'apx-portrait-field', field: field, mode: 'short', product: product, form_id: form_id, is_op: is_op, pr_collection_titles: pr_collection_titles, t_l_prime: t_l_prime, t_l_name_op: t_l_name_op, t_l_name: t_l_name, t_ph_name: t_ph_name, t_l_notes: t_l_notes, t_optional: t_optional, t_ph_notes_op: t_ph_notes_op, t_ph_notes: t_ph_notes -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture fields_long -%}
  {%- for field in props -%}
    {%- render 'apx-portrait-field', field: field, mode: 'long', product: product, form_id: form_id, is_op: is_op, pr_collection_titles: pr_collection_titles, t_l_prime: t_l_prime, t_l_name_op: t_l_name_op, t_l_name: t_l_name, t_ph_name: t_ph_name, t_l_notes: t_l_notes, t_optional: t_optional, t_ph_notes_op: t_ph_notes_op, t_ph_notes: t_ph_notes -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture feature_cards -%}
  {%- assign feat_icons = 'draw,custom,retouch' | split: ',' -%}
  {%- for label in t_feat -%}
    {%- if forloop.last -%}
      <li class="apx-feat__card apx-feat__card--hl"><span class="apx-feat__big">48 h</span><span class="apx-feat__label">{{ label }}</span></li>
    {%- else -%}
      <li class="apx-feat__card"><span class="apx-feat__icon apx-feat__icon--{{ forloop.index }}">{% render 'apx-icon', name: feat_icons[forloop.index0] %}</span><span class="apx-feat__label">{{ label }}</span></li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<script>document.documentElement.classList.add('apx-js');</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
