<script src="{{ 'apx-product.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'apx-sections.js' | asset_url }}" defer="defer"></script>

<div class="apx-scope apx-main apx-brand-fonts" data-apx-root data-section-id="{{ section.id }}">
  <script type="application/json" data-apx-json>
    {
      "formId": {{ form_id | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "updateUrl": true,
      "currentVariantId": {{ current_variant.id | json }},
      "variants": [
        {%- for v in product.variants -%}
          {"id": {{ v.id }}, "options": {{ v.options | json }}, "price": {{ v.price }}, "compare": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available | json }}, "media": {{ v.featured_media.id | default: 0 }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

  <div class="apx-main__grid">
    {%- comment -%} Galerie et cartes avantages {%- endcomment -%}
    <div class="apx-gallery apx-ratio--adapt" data-apx-gallery>
      <ul class="apx-gallery__track" data-apx-track aria-label="{{ product.title | escape }}">
        {%- for media in product.media -%}
          {%- liquid
            assign media_alt = media.alt | default: product.title
            if forloop.first
              assign img_loading = 'eager'
              assign img_priority = 'high'
            else
              assign img_loading = 'lazy'
              assign img_priority = 'auto'
            endif
          -%}
          <li class="apx-gallery__slide" data-media-id="{{ media.id }}">
            {%- if media.media_type == 'image' -%}
              {{ media | image_url: width: 1400 | image_tag: loading: img_loading, fetchpriority: img_priority, widths: '360, 540, 720, 900, 1100, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: media_alt, class: 'apx-gallery__img' }}
            {%- else -%}
              <div class="apx-gallery__media">{{ media | media_tag: image_size: '1100x' }}</div>
            {%- endif -%}
          </li>
        {%- else -%}
          <li class="apx-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'apx-gallery__img' }}</li>
        {%- endfor -%}
      </ul>
      <ul class="apx-feat apx-feat--gallery">{{ feature_cards }}</ul>
      {%- if product.media.size > 1 -%}
        <p class="apx-gallery__count" aria-hidden="true"><span data-apx-slide-index>1</span> / {{ product.media.size }}</p>
        <ul class="apx-gallery__thumbs">
          {%- for media in product.media -%}
            <li>
              <button type="button" class="apx-gallery__thumb" data-apx-thumb="{{ media.id }}" aria-label="{{ forloop.index }} / {{ product.media.size }}" {% if forloop.first %}aria-current="true"{% endif %}>
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} Zone d'achat {%- endcomment -%}
    <div class="apx-buy" id="apx-buy-{{ section.id }}">
      {%- comment -%}
        Le formulaire englobe toute la zone d'achat jusqu'au bouton : UploadKit cherche le formulaire produit autour
        de son bloc et y ajoute les photos. Les blocs placés après (after_html) restent dehors.
      {%- endcomment -%}
      {%- form 'product', product, id: form_id, class: 'apx-form', data-apx-form: '', data-productid: product.id -%}
        <select name="id" class="apx-variant-select" aria-label="Variante" data-apx-variant-select>
          {%- for v in product.variants -%}
            <option value="{{ v.id }}" {% if v.id == current_variant.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
              {{- v.title | escape }} · {{ v.price | money_with_currency | strip_html -}}
            </option>
          {%- endfor -%}
        </select>
        <input type="hidden" name="return_to" value="{{ routes.root_url | append: '/checkout' | replace: '//', '/' }}">

      {%- liquid
        assign lx_stats = shop.metafields.loox.global_stats.value | default: shop.metafields.loox.global_stats | split: ','
        assign lx_avg = lx_stats[0] | plus: 0
        assign lx_count = lx_stats[1] | plus: 0
      -%}
      <div class="apx-trust">
        <a class="apx-trust__badge apx-trust__badge--tp" href="https://fr.trustpilot.com/review/artpixe.com" target="_blank" rel="noopener">
          <span class="apx-trust__star" aria-hidden="true">★</span>
          <strong>Trustpilot</strong>
          <span class="apx-trust__score">4,4/5</span>
          <span class="apx-trust__count">31 {{ t_reviews }}</span>
        </a>
        {%- if lx_count > 0 -%}
          <a class="apx-trust__badge apx-trust__badge--lx" href="#avis">
            <span class="apx-stars" style="--apx-rating: {{ lx_avg }};" aria-hidden="true"></span>
            <span class="apx-trust__score">{{ lx_avg | round: 1 | replace: '.', ',' }}/5</span>
            <span class="apx-trust__count">{{ lx_count }} {{ t_reviews }}</span>
          </a>
        {%- endif -%}
      </div>

      <h1 class="apx-title">{{ product.title | escape }}</h1>
      <p class="apx-subtitle">{% if is_op %}{{ t_sub_op }}{% else %}{{ t_sub }}{% endif %}</p>

      <div class="apx-price">
        <s class="apx-price__was" data-apx-compare {% if savings == 0 %}hidden{% endif %}>{{ current_variant.compare_at_price | money }}</s>
        <span class="apx-price__now" data-apx-price>{{ current_variant.price | money }}</span>
        {%- assign savings_money = savings | money -%}
        <span class="apx-price__save" data-apx-savings data-template="{{ t_save | escape }}" {% if savings == 0 %}hidden{% endif %}>{{ t_save | replace: '[montant]', savings_money }}</span>
      </div>

      {%- comment -%} 1. Nombre (pastilles) · 2. Format (cartes) {%- endcomment -%}
      <div class="apx-picker" id="apx-config" data-apx-picker data-chips-price="none" data-cards-price="true">
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign opt_index0 = forloop.index0
            assign opt_index = forloop.index
            assign is_card = false
            if option.name == 'Version'
              assign is_card = true
            endif
            if is_card
              assign heading = t_format
            elsif opt_index == 1
              assign heading = t_opt1
            else
              assign heading = option.name
            endif
            assign cur_val = current_variant.options[opt_index0]
            assign cur_label = cur_val
            assign label_id = 'apx-' | append: section.id | append: '-l' | append: opt_index
          -%}
          {%- if option.values.size > 1 -%}
            {%- comment -%} Les cartes Displate passent en premier, les autres gardent l'ordre du produit {%- endcomment -%}
            {%- assign values_first = '' -%}
            {%- assign values_rest = '' -%}
              {%- for value in option.values -%}
                {%- liquid
                  assign value_name = value.name | default: value
                  assign input_id = 'apx-' | append: section.id | append: '-o' | append: opt_index | append: '-' | append: forloop.index
                  assign match = nil
                  for v in product.variants
                    assign ok = true
                    for o in v.options
                      if forloop.index0 == opt_index0
                        if o != value_name
                          assign ok = false
                        endif
                      elsif o != current_variant.options[forloop.index0]
                        assign ok = false
                      endif
                    endfor
                    if ok
                      assign match = v
                      break
                    endif
                  endfor

                  assign card = ''
                  assign card_icon = ''
                  assign card_badge = ''
                  assign card_style = 'default'
                  case value_name
                    when 'Digital'
                      assign card = t_c_hd | split: '|'
                      assign card_icon = '💻'
                      assign card_badge = t_eco
                      assign card_style = 'green'
                    when 'Poster A3'
                      assign card = t_c_a3 | split: '|'
                      assign card_icon = '🖼️'
                    when 'Displate'
                      assign card = t_c_dp | split: '|'
                      assign card_icon = '✨'
                      assign card_badge = t_reco
                      assign card_style = 'feat'
                    when 'Displate avec cadre'
                      assign card = t_c_fr | split: '|'
                      assign card_icon = '🏆'
                      assign card_badge = 'Premium'
                      assign card_style = 'gold'
                  endcase
                  assign card_label = card[0] | default: value_name
                  assign card_desc = card[1]
                  if value_name == cur_val
                    assign cur_label = card_label
                  endif
                -%}
                {%- capture value_html -%}
                <div class="apx-val apx-val--{{ card_style }}">
                  <input type="radio" class="apx-val__input" id="{{ input_id }}" name="apx-{{ section.id }}-o{{ opt_index }}" value="{{ value_name | escape }}" data-apx-value data-label="{{ card_label | escape }}" {% if value_name == cur_val %}checked{% endif %} {% unless match and match.available %}data-unavailable{% endunless %}>
                  <label class="apx-val__label" for="{{ input_id }}">
                    {%- if is_card -%}
                      <span class="apx-val__check" aria-hidden="true">{% render 'apx-icon', name: 'check' %}</span>
                      {%- if card_badge != blank -%}<span class="apx-val__badge">{{ card_badge }}</span>{%- endif -%}
                      {%- if card_icon != blank -%}<span class="apx-val__icon" aria-hidden="true">{{ card_icon }}</span>{%- endif -%}
                    {%- endif -%}
                    <span class="apx-val__name">{{ card_label }}</span>
                    {%- if is_card and card_desc != blank -%}<span class="apx-val__desc">{{ card_desc }}</span>{%- endif -%}
                    <span class="apx-val__price" data-apx-value-price>{%- if is_card and match -%}{{ match.price | money }}{%- endif -%}</span>
                  </label>
                </div>
                {%- endcapture -%}
                {%- if is_card and value_name contains 'Displate' -%}
                  {%- assign values_first = values_first | append: value_html -%}
                {%- else -%}
                  {%- assign values_rest = values_rest | append: value_html -%}
                {%- endif -%}
              {%- endfor -%}
            {%- assign values_html = values_first | append: values_rest -%}
            <div class="apx-opt {% if is_card %}apx-opt--cards{% else %}apx-opt--chips{% endif %} apx-opt--step" role="radiogroup" aria-labelledby="{{ label_id }}" data-apx-option="{{ opt_index0 }}">
              <p class="apx-opt__label apx-stephead" id="{{ label_id }}">
                <span class="apx-stephead__num" aria-hidden="true"></span>
                <span class="apx-opt__name">{{ heading }}</span>
                <span class="apx-opt__sep" aria-hidden="true"> : </span>
                <span class="apx-opt__current" data-apx-current>{{ cur_label }}</span>
              </p>
              {%- comment -%} Plus de 7 pastilles : deux lignes égales sur mobile {%- endcomment -%}
              {%- assign rows_cols = 0 -%}
              {%- if is_card == false and option.values.size > 7 -%}
                {%- assign rows_cols = option.values.size | plus: 1 | divided_by: 2 | floor -%}
              {%- endif -%}
              <div class="apx-opt__values{% if rows_cols > 0 %} apx-opt__values--rows{% endif %}"{% if rows_cols > 0 %} style="--apx-cols: {{ rows_cols }}"{% endif %}>{{ values_html }}</div>
              {%- if opt_index == 1 and is_card == false -%}
                <p class="apx-upsell" data-apx-upsell data-template="{{ t_upsell | escape }}" hidden></p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} 3. Nom (et prime) {%- endcomment -%}
      {%- assign short_html = fields_short | strip -%}
      {%- if short_html != blank -%}
        <div class="apx-stepline">
          <p class="apx-stephead"><span class="apx-stephead__num" aria-hidden="true"></span>{% if is_op %}{{ t_step_op }}{% else %}{{ t_step_custom }}{% endif %}</p>
        </div>
        <div class="apx-field-row apx-field-row--auto">{{ short_html }}</div>
      {%- endif -%}

      {%- comment -%} 4. Photos {%- endcomment -%}
      <div class="apx-stepline">
        <p class="apx-stephead"><span class="apx-stephead__num" aria-hidden="true"></span>{{ t_step_photos }}</p>
        <p class="apx-hint">{{ t_hint_photos }}</p>
      </div>
      {%- comment -%}
        UploadKit monte son bouton dans le premier div.uploadkit de la page ; sans lui, il l'injecte avant le bouton
        de commande. Son bloc d'application ne rend rien : on pose ce div ici, dans le formulaire.
      {%- endcomment -%}
      <div class="apx-app">
        {{- upload_html -}}
        {%- unless upload_html contains 'class="uploadkit' -%}<div class="uploadkit"></div>{%- endunless -%}
      </div>
      <div class="apx-later">
        <input type="checkbox" id="apx-p-{{ section.id }}" name="properties[Photo]" form="{{ form_id }}" value="Envoyée plus tard par e-mail">
        <label for="apx-p-{{ section.id }}"><span aria-hidden="true">📎</span> {{ t_later }}</label>
      </div>
      {{ fields_long }}

      <div class="apx-buy-buttons">
        <button type="submit" name="add" form="{{ form_id }}" class="apx-btn apx-btn--primary apx-btn--buy" data-apx-submit data-label="{{ t_buy | escape }}" data-soldout="{{ t_soldout | escape }}" {% unless current_variant.available %}disabled{% endunless %}>
          <span data-apx-btn-label>{% if current_variant.available %}{{ t_buy }}{% else %}{{ t_soldout }}{% endif %}</span>
          <span class="apx-btn__prices">
            <s data-apx-compare {% if savings == 0 %}hidden{% endif %}>{{ current_variant.compare_at_price | money }}</s>
            <span data-apx-price>{{ current_variant.price | money }}</span>
          </span>
        </button>
        <p class="apx-error" role="alert" data-apx-error hidden></p>
        <div class="apx-micro"><p>{{ t_micro }}</p></div>
      </div>
      {%- endform -%}

      {{ after_html }}
      <ul class="apx-feat apx-feat--mobile">{{ feature_cards }}</ul>
      {%- if pack_html != blank -%}<div class="apx-liquid t4s-pr__custom-liquid t4s-rte"><div class="apx-pack">{{ pack_html }}</div></div>{%- endif -%}
    </div>
  </div>

  <div class="apx-sticky" data-apx-sticky data-mode="scroll" hidden>
    <div class="apx-sticky__info">
      <span class="apx-sticky__title">{{ product.title | escape }}</span>
      <span class="apx-sticky__price" data-apx-price>{{ current_variant.price | money }}</span>
    </div>
    <button type="button" class="apx-btn apx-btn--primary apx-sticky__btn" data-apx-sticky-btn>{{ t_sticky }}</button>
  </div>
</div>

{%- comment -%} Navigation entre les sections : liens trouvés automatiquement dans la page (assets/apx-sections.js) {%- endcomment -%}
<nav
  class="apx-pnav"
  data-apx-pnav
  data-auto
  data-after-el="[data-apx-root]"
  data-buy="#apx-config"
  data-order-links=".apx-how__btn, .ap-faq-cta"
  data-fold=".apx-seo"
  data-fold-height="320"
  data-l-avis="{{ t_nav[1] | escape }}"
  data-l-how="{{ t_nav[2] | escape }}"
  data-l-reco="{{ t_nav[3] | escape }}"
  data-l-faq="{{ t_nav[4] | escape }}"
  data-l-guide="{{ t_nav[5] | escape }}"
  data-more="{{ t_nav[6] | escape }}"
  data-less="{{ t_nav[7] | escape }}"
  aria-label="{{ t_nav[0] | escape }}"
  hidden
>
  <div class="apx-pnav__inner"><ul class="apx-pnav__list"></ul></div>
  <span class="apx-pnav__progress" aria-hidden="true"></span>
</nav>
