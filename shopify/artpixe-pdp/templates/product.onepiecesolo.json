      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  ARTPIXE — Produits recommandés — Custom Liquid Block\n  \"Vous aimez One Piece ? Vous aimerez aussi...\"\n  Carousel scroll-snap · DA Artpixe · i18n 5 langues\n  ⚠️ Remplace le bloc Featured Collection natif Kalles\n     → élimine les H3 parasites dans la structure SEO\n  v1.1 : ancres CTA optimisées SEO (courtes)\n{% endcomment %}\n\n{%- assign lang_raw = localization.language.iso_code | default: request.locale.iso_code | default: shop.locale -%}\n{%- assign lang = lang_raw | downcase | replace: '_', '-' | split: '-' | first -%}\n\n{%- case lang -%}\n  {%- when 'en' -%}\n    {%- assign t_badge  = \"You may also like\" -%}\n    {%- assign t_title  = \"Loved the One Piece poster? You'll love these too\" -%}\n    {%- assign t_sub    = \"Other personalised manga portraits — same quality, different universe.\" -%}\n    {%- assign t_from   = \"From\" -%}\n    {%- assign t_cta_naruto  = \"Naruto portrait →\" -%}\n    {%- assign t_cta_dbz     = \"DBZ portrait →\" -%}\n    {%- assign t_cta_bleach  = \"Bleach portrait →\" -%}\n    {%- assign t_cta_ghibli  = \"Ghibli portrait →\" -%}\n    {%- assign t_collection  = \"All personalised manga portraits →\" -%}\n\n  {%- when 'es' -%}\n    {%- assign t_badge  = \"Te puede gustar\" -%}\n    {%- assign t_title  = \"Te encanto el cartel One Piece? Tambien te gustaran estos\" -%}\n    {%- assign t_sub    = \"Otros retratos manga personalizados — misma calidad, universo diferente.\" -%}\n    {%- assign t_from   = \"Desde\" -%}\n    {%- assign t_cta_naruto  = \"Retrato Naruto personalizado →\" -%}\n    {%- assign t_cta_dbz     = \"Retrato DBZ personalizado →\" -%}\n    {%- assign t_cta_bleach  = \"Retrato Bleach personalizado →\" -%}\n    {%- assign t_cta_ghibli  = \"Retrato Ghibli personalizado →\" -%}\n    {%- assign t_collection  = \"Todos los retratos manga →\" -%}\n\n  {%- when 'de' -%}\n    {%- assign t_badge  = \"Das konnte dir gefallen\" -%}\n    {%- assign t_title  = \"One Piece Poster geliebt? Diese wirst du auch lieben\" -%}\n    {%- assign t_sub    = \"Weitere personalisierte Manga-Portrats — gleiche Qualitat, anderes Universum.\" -%}\n    {%- assign t_from   = \"Ab\" -%}\n    {%- assign t_cta_naruto  = \"Naruto portrait →\" -%}\n    {%- assign t_cta_dbz     = \"DBZ portrait →\" -%}\n    {%- assign t_cta_bleach  = \"Bleach portrait →\" -%}\n    {%- assign t_cta_ghibli  = \"Ghibli portrait →\" -%}\n    {%- assign t_collection  = \"Alle Manga-Portraits ansehen →\" -%}\n\n  {%- when 'it' -%}\n    {%- assign t_badge  = \"Potrebbe piacerti\" -%}\n    {%- assign t_title  = \"Hai amato il poster One Piece? Amerai anche questi\" -%}\n    {%- assign t_sub    = \"Altri ritratti manga personalizzati — stessa qualita, universo diverso.\" -%}\n    {%- assign t_from   = \"Da\" -%}\n    {%- assign t_cta_naruto  = \"Ritratto Naruto →\" -%}\n    {%- assign t_cta_dbz     = \"Ritratto DBZ →\" -%}\n    {%- assign t_cta_bleach  = \"Ritratto Bleach →\" -%}\n    {%- assign t_cta_ghibli  = \"Ritratto Ghibli →\" -%}\n    {%- assign t_collection  = \"Tutti i ritratti manga →\" -%}\n\n  {%- else -%}\n    {%- assign t_badge  = \"Vous aimerez aussi\" -%}\n    {%- assign t_title  = \"Vous aimez nos affiches One Piece ? Vous aimerez aussi...\" -%}\n    {%- assign t_sub    = \"D'autres portraits manga personnalisés — même qualité, même passion.\" -%}\n    {%- assign t_from   = \"Dès\" -%}\n    {%- assign t_cta_naruto  = \"Portrait Naruto personnalisé →\" -%}\n    {%- assign t_cta_dbz     = \"Portrait Dragon Ball Z →\" -%}\n    {%- assign t_cta_bleach  = \"Portrait Bleach personnalisé →\" -%}\n    {%- assign t_cta_ghibli  = \"Portrait Ghibli personnalisé →\" -%}\n    {%- assign t_collection  = \"Tous les portraits manga personnalisés →\" -%}\n{%- endcase -%}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n\n<section class=\"apx-reco\" id=\"apx-reco\">\n  <div class=\"apx-reco__inner\">\n\n    <div class=\"apx-reco__head\">\n      <span class=\"apx-reco__badge\">{{ t_badge }}</span>\n      <h2 class=\"apx-reco__title\">{{ t_title }}</h2>\n      <p class=\"apx-reco__sub\">{{ t_sub }}</p>\n    </div>\n\n    <div class=\"apx-reco__track\" id=\"apx-reco-track\">\n\n      <!-- Naruto -->\n      <a class=\"apx-reco__card\" href=\"/products/portrait-personnalise-naruto\">\n        <div class=\"apx-reco__img-wrap\">\n          <img\n            src=\"https://artpixe.com/cdn/shop/files/ma_photo_version_naruto.webp?v=1771349564&width=400\"\n            alt=\"Portrait personnalisé style Naruto — transformer sa photo en manga Naruto\"\n            width=\"400\" height=\"auto\"\n            loading=\"lazy\"\n          >\n          <span class=\"apx-reco__universe\">Naruto</span>\n        </div>\n        <div class=\"apx-reco__info\">\n          <p class=\"apx-reco__name\">Portrait Naruto personnalisé</p>\n          <p class=\"apx-reco__price\">{{ t_from }} 19,90 €</p>\n        </div>\n        <span class=\"apx-reco__btn\">{{ t_cta_naruto }}</span>\n      </a>\n\n      <!-- Dragon Ball Z -->\n      <a class=\"apx-reco__card\" href=\"/products/portrait-personnalise-dragon-ball-z\">\n        <div class=\"apx-reco__img-wrap\">\n          <img\n            src=\"https://artpixe.com/cdn/shop/files/portrait_personnalis_style_dragon_ball.webp?v=1772034131&width=400\"\n            alt=\"Portrait personnalisé style Dragon Ball Z — affiche DBZ avec ta photo\"\n            width=\"400\" height=\"auto\"\n            loading=\"lazy\"\n          >\n          <span class=\"apx-reco__universe\">Dragon Ball Z</span>\n        </div>\n        <div class=\"apx-reco__info\">\n          <p class=\"apx-reco__name\">Portrait Dragon Ball Z personnalisé</p>\n          <p class=\"apx-reco__price\">{{ t_from }} 19,90 €</p>\n        </div>\n        <span class=\"apx-reco__btn\">{{ t_cta_dbz }}</span>\n      </a>\n\n      <!-- Bleach -->\n      <a class=\"apx-reco__card\" href=\"/products/portrait-manga-personnalise-bleach\">\n        <div class=\"apx-reco__img-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0782/3494/3826/files/transformer_ma_phot_en_manga.webp?v=1771349505&width=400\"\n            alt=\"Portrait personnalisé style Bleach — transformer sa photo en Shinigami\"\n            width=\"400\" height=\"auto\"\n            loading=\"lazy\"\n          >\n          <span class=\"apx-reco__universe\">Bleach</span>\n        </div>\n        <div class=\"apx-reco__info\">\n          <p class=\"apx-reco__name\">Portrait Bleach personnalisé</p>\n          <p class=\"apx-reco__price\">{{ t_from }} 19,90 €</p>\n        </div>\n        <span class=\"apx-reco__btn\">{{ t_cta_bleach }}</span>\n      </a>\n\n      <!-- Studio Ghibli -->\n      <a class=\"apx-reco__card\" href=\"/products/portrait-manga-personnalise-studio-ghibli\">\n        <div class=\"apx-reco__img-wrap\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0782/3494/3826/files/portrait_studio_giblhi.webp?v=1772034091&width=400\"\n            alt=\"Portrait personnalisé style Studio Ghibli — transformer sa photo en personnage Ghibli\"\n            width=\"400\" height=\"auto\"\n            loading=\"lazy\"\n          >\n          <span class=\"apx-reco__universe apx-reco__universe--ghibli\">Studio Ghibli</span>\n        </div>\n        <div class=\"apx-reco__info\">\n          <p class=\"apx-reco__name\">Portrait Studio Ghibli personnalisé</p>\n          <p class=\"apx-reco__price\">{{ t_from }} 19,90 €</p>\n        </div>\n        <span class=\"apx-reco__btn\">{{ t_cta_ghibli }}</span>\n      </a>\n\n    </div>\n\n    <!-- Dots mobile -->\n    <div class=\"apx-reco__dots\" id=\"apx-reco-dots\" aria-hidden=\"true\">\n      <button class=\"apx-reco__dot active\" data-idx=\"0\"></button>\n      <button class=\"apx-reco__dot\" data-idx=\"1\"></button>\n      <button class=\"apx-reco__dot\" data-idx=\"2\"></button>\n      <button class=\"apx-reco__dot\" data-idx=\"3\"></button>\n    </div>\n\n    <!-- CTA collection -->\n    <div class=\"apx-reco__footer\">\n      <a href=\"/collections/portrait-personnalise-manga\" class=\"apx-reco__collection-btn\">\n        {{ t_collection }}\n      </a>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .apx-reco{\n    padding: 64px 20px;\n    background: transparent;\n    font-family: 'DM Sans', sans-serif;\n    overflow: hidden;\n  }\n  .apx-reco__inner{ max-width: 1100px; margin: 0 auto; }\n  .apx-reco__head{ text-align: center; margin-bottom: 36px; }\n  .apx-reco__badge{\n    display: inline-flex;\n    background: rgba(245,166,35,.1);\n    border: 1px solid rgba(245,166,35,.25);\n    color: #f5a623;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    padding: 5px 14px;\n    border-radius: 99px;\n    margin-bottom: 12px;\n  }\n  .apx-reco__title{\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: clamp(24px, 3vw, 40px);\n    letter-spacing: .02em;\n    line-height: 1.05;\n    color: #f0ede8;\n    margin: 0 0 8px;\n  }\n  .apx-reco__sub{\n    font-size: 14px;\n    font-weight: 300;\n    color: #9a9690;\n    margin: 0;\n  }\n  .apx-reco__track{\n    display: flex;\n    gap: 14px;\n  }\n  .apx-reco__card{\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    background: #141416;\n    border-radius: 16px;\n    overflow: hidden;\n    text-decoration: none;\n    transition: transform .25s;\n  }\n  .apx-reco__card:hover{ transform: translateY(-4px); }\n  .apx-reco__img-wrap{ position: relative; overflow: hidden; }\n  .apx-reco__img-wrap img{\n    width: 100%; height: auto; display: block;\n    transition: transform .4s ease;\n  }\n  .apx-reco__card:hover .apx-reco__img-wrap img{ transform: scale(1.04); }\n  .apx-reco__universe{ display: none; }\n  .apx-reco__info{ padding: 12px 14px 4px; flex: 1; }\n  .apx-reco__name{\n    font-size: 13px; font-weight: 500;\n    color: #f0ede8; margin: 0 0 4px; line-height: 1.3;\n  }\n  .apx-reco__price{\n    font-size: 12px; font-weight: 300;\n    color: #f5a623; margin: 0;\n  }\n  .apx-reco__btn{\n    display: block;\n    margin: 10px 14px 14px;\n    padding: 8px 0;\n    text-align: center;\n    background: rgba(245,166,35,.1);\n    border: 1px solid rgba(245,166,35,.2);\n    color: #f5a623;\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 13px;\n    letter-spacing: .05em;\n    border-radius: 99px;\n    transition: background .2s, border-color .2s;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .apx-reco__card:hover .apx-reco__btn{\n    background: #f5a623; color: #000; border-color: #f5a623;\n  }\n  .apx-reco__footer{ text-align: center; margin-top: 28px; }\n  .apx-reco__collection-btn{\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 9px 20px;\n    border-radius: 99px;\n    border: 1px solid rgba(245,166,35,.35);\n    background: transparent;\n    color: #f5a623;\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 13px;\n    letter-spacing: .06em;\n    text-decoration: none;\n    transition: background .2s, border-color .2s, color .2s;\n  }\n  .apx-reco__collection-btn:hover{\n    background: #f5a623; border-color: #f5a623; color: #000;\n  }\n  .apx-reco__dots{ display: none; }\n\n  @media(max-width: 760px){\n    .apx-reco{ padding: 52px 0; }\n    .apx-reco__inner{ padding: 0; }\n    .apx-reco__head{ padding: 0 20px; }\n    .apx-reco__track{\n      overflow-x: scroll;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n      gap: 0;\n      padding: 4px 0 12px;\n    }\n    .apx-reco__track::-webkit-scrollbar{ display: none; }\n    .apx-reco__card{\n      flex: 0 0 calc(100vw - 80px);\n      max-width: 260px;\n      scroll-snap-align: center;\n      margin: 0 8px;\n      transform: none !important;\n    }\n    .apx-reco__card:first-child{ margin-left: calc((100vw - (100vw - 80px)) / 2); }\n    .apx-reco__card:last-child{ margin-right: calc((100vw - (100vw - 80px)) / 2); }\n    .apx-reco__dots{\n      display: flex; justify-content: center; gap: 8px; margin: 8px 0 0;\n    }\n    .apx-reco__dot{\n      width: 8px; height: 8px; border-radius: 99px; border: none;\n      background: rgba(255,255,255,.2); padding: 0; cursor: pointer;\n      transition: background .2s, width .2s;\n    }\n    .apx-reco__dot.active{ background: #f5a623; width: 22px; }\n    .apx-reco__collection-btn{ font-size: 12px; padding: 8px 18px; width: auto; }\n  }\n\n  @media(min-width: 761px) and (max-width: 1024px){\n    .apx-reco__card:nth-child(4){ display: none; }\n  }\n\n  @media(prefers-reduced-motion: reduce){\n    .apx-reco__card,\n    .apx-reco__img-wrap img{ transition: none !important; }\n  }\n</style>\n\n<script>\n(function(){\n  var section = document.getElementById('apx-reco');\n  if(!section || section.dataset.apxInit === '1') return;\n  section.dataset.apxInit = '1';\n\n  var track = document.getElementById('apx-reco-track');\n  var dots  = document.querySelectorAll('#apx-reco-dots .apx-reco__dot');\n  var cards = track ? track.querySelectorAll('.apx-reco__card') : [];\n  if(!track || !dots.length || !cards.length) return;\n\n  function onScroll(){\n    var idx = Math.round(track.scrollLeft / (track.scrollWidth / cards.length));\n    idx = Math.max(0, Math.min(idx, cards.length - 1));\n    dots.forEach(function(d,i){ d.classList.toggle('active', i === idx); });\n    cards.forEach(function(c,i){ c.classList.toggle('is-active', i === idx); });\n  }\n\n  dots.forEach(function(dot){\n    dot.addEventListener('click', function(){\n      var card = cards[parseInt(this.dataset.idx, 10)];\n      if(card) track.scrollTo({\n        left: card.offsetLeft - (track.offsetWidth - card.offsetWidth) / 2,\n        behavior: 'smooth'\n      });\n    });\n  });\n\n  track.addEventListener('scroll', onScroll, { passive: true });\n  onScroll();\n})();\n</script>",
