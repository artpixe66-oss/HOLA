      "settings": {
        "custom_liquid": "{% comment %}\n  artpixe-custom-liquid-bandeau-promo.liquid  v5\n  Bandeau fixe full-width — 1 ligne fixe desktop — défilement marquee mobile\n{% endcomment %}\n{%- assign lang_raw = localization.language.iso_code | default: request.locale.iso_code | default: shop.locale -%}\n{%- assign lang = lang_raw | downcase | replace: '_', '-' | split: '-' | first -%}\n\n{%- if lang == 'en' -%}\n  {%- assign txt_main = '-10% off your order' -%}\n  {%- assign txt_with = 'with code' -%}\n  {%- assign txt_ends = 'Ends in' -%}\n{%- elsif lang == 'es' -%}\n  {%- assign txt_main = '-10% en tu pedido' -%}\n  {%- assign txt_with = 'con el codigo' -%}\n  {%- assign txt_ends = 'Termina en' -%}\n{%- elsif lang == 'de' -%}\n  {%- assign txt_main = '-10% auf deine Bestellung' -%}\n  {%- assign txt_with = 'mit dem Code' -%}\n  {%- assign txt_ends = 'Endet in' -%}\n{%- elsif lang == 'it' -%}\n  {%- assign txt_main = '-10% sul tuo ordine' -%}\n  {%- assign txt_with = 'con il codice' -%}\n  {%- assign txt_ends = 'Scade tra' -%}\n{%- else -%}\n  {%- assign txt_main = '-10% sur votre commande' -%}\n  {%- assign txt_with = 'avec le code' -%}\n  {%- assign txt_ends = 'Expire dans' -%}\n{%- endif -%}\n\n<style>\n.apb-outer{\n  position:relative;\n  left:50%;right:50%;\n  margin-left:-50vw;margin-right:-50vw;\n  width:100vw;\n  overflow:hidden;\n}\n.apb{\n  background:#f5a623;\n  width:100%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  padding:9px 16px;\n  font-family:var(--font-body-family,'DM Sans',sans-serif);\n  font-size:13px;\n  color:#fff;\n  white-space:nowrap;\n  border-bottom:1px solid rgba(0,0,0,.1);\n  overflow:hidden;\n}\n\n/* Contenu statique desktop */\n.apb-static{\n  display:flex;\n  align-items:center;\n  gap:6px;\n  white-space:nowrap;\n}\n\n/* Marquee mobile */\n.apb-marquee-wrap{\n  display:none;\n  overflow:hidden;\n  width:100%;\n}\n.apb-marquee-track{\n  display:inline-flex;\n  align-items:center;\n  gap:0;\n  white-space:nowrap;\n  animation:apbScroll 18s linear infinite;\n}\n.apb-marquee-track:hover{animation-play-state:paused;}\n.apb-marquee-item{\n  display:inline-flex;\n  align-items:center;\n  gap:6px;\n  padding-right:48px;\n}\n@keyframes apbScroll{\n  0%{transform:translateX(0);}\n  100%{transform:translateX(-50%);}\n}\n\n.apb-bold{font-weight:700;}\n.apb-sep{opacity:.45;margin:0 4px;}\n.apb-code{\n  background:rgba(0,0,0,.18);\n  border-radius:3px;\n  padding:1px 8px;\n  font-weight:700;\n  letter-spacing:.05em;\n}\n.apb-timer{\n  display:inline-flex;\n  align-items:baseline;\n  gap:3px;\n  font-weight:700;\n  font-variant-numeric:tabular-nums;\n}\n.apb-unit{font-size:10px;font-weight:600;opacity:.7;}\n\n/* Sur mobile : masquer statique, afficher marquee */\n@media(max-width:700px){\n  .apb-static{display:none;}\n  .apb-marquee-wrap{display:block;}\n  .apb{padding:9px 0;justify-content:flex-start;}\n}\n</style>\n\n<div class=\"apb-outer\">\n  <div class=\"apb\" role=\"banner\">\n\n    <!-- Desktop : 1 ligne fixe -->\n    <div class=\"apb-static\">\n      <span>🔥</span>\n      <span><span class=\"apb-bold\">{{ txt_main }}</span> {{ txt_with }}</span>\n      <span class=\"apb-code\">C10</span>\n      <span class=\"apb-sep\">·</span>\n      <span>{{ txt_ends }}</span>\n      <span class=\"apb-timer\">\n        <span><span class=\"apbH\">--</span><span class=\"apb-unit\">h</span></span>\n        <span style=\"opacity:.4\">:</span>\n        <span><span class=\"apbM\">--</span><span class=\"apb-unit\">m</span></span>\n        <span style=\"opacity:.4\">:</span>\n        <span><span class=\"apbS\">--</span><span class=\"apb-unit\">s</span></span>\n      </span>\n    </div>\n\n    <!-- Mobile : marquee défilant (dupliqué x2 pour boucle fluide) -->\n    <div class=\"apb-marquee-wrap\">\n      <div class=\"apb-marquee-track\">\n        <!-- Exemplaire 1 -->\n        <span class=\"apb-marquee-item\">\n          <span>🔥</span>\n          <span><span class=\"apb-bold\">{{ txt_main }}</span> {{ txt_with }}</span>\n          <span class=\"apb-code\">C10</span>\n          <span class=\"apb-sep\">·</span>\n          <span>{{ txt_ends }}</span>\n          <span class=\"apb-timer\">\n            <span><span class=\"apbH\">--</span><span class=\"apb-unit\">h</span></span>\n            <span style=\"opacity:.4\">:</span>\n            <span><span class=\"apbM\">--</span><span class=\"apb-unit\">m</span></span>\n            <span style=\"opacity:.4\">:</span>\n            <span><span class=\"apbS\">--</span><span class=\"apb-unit\">s</span></span>\n          </span>\n        </span>\n        <!-- Exemplaire 2 (clone pour boucle) -->\n        <span class=\"apb-marquee-item\">\n          <span>🔥</span>\n          <span><span class=\"apb-bold\">{{ txt_main }}</span> {{ txt_with }}</span>\n          <span class=\"apb-code\">C10</span>\n          <span class=\"apb-sep\">·</span>\n          <span>{{ txt_ends }}</span>\n          <span class=\"apb-timer\">\n            <span><span class=\"apbH\">--</span><span class=\"apb-unit\">h</span></span>\n            <span style=\"opacity:.4\">:</span>\n            <span><span class=\"apbM\">--</span><span class=\"apb-unit\">m</span></span>\n            <span style=\"opacity:.4\">:</span>\n            <span><span class=\"apbS\">--</span><span class=\"apb-unit\">s</span></span>\n          </span>\n        </span>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function(){\n  var CYCLE=5*60*60*1000, KEY='ap_promo_v2';\n  function getStart(){\n    try{var t=parseInt(localStorage.getItem(KEY),10);if(t&&Date.now()-t<CYCLE)return t;}catch(e){}\n    var n=Date.now();try{localStorage.setItem(KEY,n);}catch(e){}return n;\n  }\n  var start=getStart();\n  function pad(n){return n<10?'0'+n:''+n;}\n  function tick(){\n    var el=Date.now()-start;\n    if(el>=CYCLE){start=Date.now();try{localStorage.setItem(KEY,start);}catch(e){}el=0;}\n    var rem=Math.floor((CYCLE-el)/1e3);\n    var h=pad(Math.floor(rem/3600));\n    var m=pad(Math.floor((rem%3600)/60));\n    var s=pad(rem%60);\n    document.querySelectorAll('.apbH').forEach(function(e){e.textContent=h;});\n    document.querySelectorAll('.apbM').forEach(function(e){e.textContent=m;});\n    document.querySelectorAll('.apbS').forEach(function(e){e.textContent=s;});\n  }\n  tick();setInterval(tick,1000);\n})();\n</script>",
