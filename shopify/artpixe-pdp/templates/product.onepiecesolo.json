    "custom_liquid_NAqn6n": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  artpixe-faq-one-piece-v3.liquid\n  FAQ 8 questions — One Piece\n  v3 : suppression microdata (itemscope/itemprop) — JSON-LD seul conservé\n       → résout l'erreur \"FAQPage en double\" dans Google Search Console\n{% endcomment %}\n\n{% liquid\n  assign lang = localization.language.iso_code | default: request.locale.iso_code | default: shop.locale\n  case lang\n    when 'de'\n      assign faq_title = 'Alles über dein persönliches Wanted One Piece Poster'\n      assign q1 = 'Kann ich den Namen und die Prämie auf dem Poster wählen?'\n      assign a1 = 'Ja, du kannst den Namen, die Prämie (in Berries) und die Aufschrift anpassen. Gib diese Details im Personalisierungsfeld an.'\n      assign q2 = 'Kann ich mehrere Personen auf einem Wanted-Poster haben?'\n      assign a2 = 'Ja! Bis zu 3 Personen auf demselben Poster. Füge einfach ein Foto jeder Person hinzu.'\n      assign q3 = 'Welches Foto soll ich einsenden?'\n      assign a3 = 'Ein klares Foto, auf dem dein Gesicht gut sichtbar ist. Vermeide Sonnenbrillen oder Masken.'\n      assign q4 = 'Kann ich den One Piece-Stil wählen (Wano, Marine Ford, New World)?'\n      assign a4 = 'Ja! Nenne uns den Stil deiner Wahl beim Bestellen und unser Grafiker passt sich an.'\n      assign q5 = 'Wie lange dauert es, bis ich meine Vorschau erhalte?'\n      assign a5 = 'Die Vorschau wird innerhalb von 48 Arbeitsstunden geliefert. Du siehst das Ergebnis vor der Bestätigung.'\n      assign q6 = 'Wie viele Korrekturen sind inbegriffen?'\n      assign a6 = 'Unbegrenzte Korrekturen sind im Preis inbegriffen. Wir überarbeiten bis du vollständig zufrieden bist.'\n      assign q7 = 'Welches Format soll ich wählen, um das Poster zu verschenken?'\n      assign a7 = 'Das Displate-Metallrahmen-Format ist unser meistverkauftes Geschenk: Premium-Qualität und unvergesslicher Eindruck.'\n      assign q8 = 'Wird das Portrait von einem Menschen oder einer KI erstellt?'\n      assign a8 = 'Jedes Portrait wird von Hand von unserem Grafiker erstellt. Kein KI-Filter — echtes menschliches Talent.'\n      assign cta_text = 'Mein Wanted-Poster bestellen →'\n    when 'es'\n      assign faq_title = 'Todo sobre tu cartel Wanted One Piece personalizado'\n      assign q1 = '¿Puedo elegir el nombre y la recompensa del cartel?'\n      assign a1 = 'Sí, puedes personalizar el nombre, la recompensa (en berries) y la mención. Indica estos detalles al realizar tu pedido.'\n      assign q2 = '¿Puedo poner varias personas en el mismo cartel Wanted?'\n      assign a2 = '¡Sí, sin problema! Hasta 3 personas en el mismo cartel. Solo añade una foto de cada persona.'\n      assign q3 = '¿Qué foto debo enviar?'\n      assign a3 = 'Necesitamos una foto clara donde tu cara sea bien visible. Evita gafas de sol o máscaras.'\n      assign q4 = '¿Puedo elegir el estilo de One Piece (Wano, Marine Ford, New World)?'\n      assign a4 = '¡Sí! Indícanos el estilo de tu elección al realizar el pedido y nuestro diseñador se adapta.'\n      assign q5 = '¿Cuánto tiempo tarda en llegar la vista previa?'\n      assign a5 = 'La vista previa se entrega en 48 horas laborables. Ves el resultado antes de validar nada.'\n      assign q6 = '¿Cuántas correcciones están incluidas?'\n      assign a6 = 'Las correcciones son ilimitadas e incluidas. Revisamos hasta que estés completamente satisfecho.'\n      assign q7 = '¿Qué formato elegir para regalar el cartel?'\n      assign a7 = 'El marco Displate metal es el más regalado: calidad premium, efecto sorpresa garantizado.'\n      assign q8 = '¿El retrato es realizado por un humano o por una IA?'\n      assign a8 = 'Cada retrato es creado a mano por nuestro diseñador especializado en cultura pop. Cero IA.'\n      assign cta_text = 'Pedir mi cartel Wanted →'\n    when 'en'\n      assign faq_title = 'Everything about your personalized Wanted One Piece poster'\n      assign q1 = 'Can I choose the name and bounty on the poster?'\n      assign a1 = 'Yes, you can customize the name, the bounty (in berries) and the mention. Indicate these details when ordering.'\n      assign q2 = 'Can I have multiple people on the same Wanted poster?'\n      assign a2 = 'Yes, no problem! Up to 3 people on the same poster. Just add a photo of each person.'\n      assign q3 = 'What photo should I send?'\n      assign a3 = 'We need a clear photo where your face is clearly visible. Avoid sunglasses or masks.'\n      assign q4 = 'Can I choose the One Piece style (Wano, Marine Ford, New World)?'\n      assign a4 = 'Yes! Tell us the style you want when ordering and our designer adapts.'\n      assign q5 = 'How long does it take to receive my preview?'\n      assign a5 = 'The preview is delivered within 48 business hours. You see the result before validating anything.'\n      assign q6 = 'How many revisions are included?'\n      assign a6 = 'Revisions are unlimited and included in the price. We revise until you are completely satisfied.'\n      assign q7 = 'Which format should I choose to give the poster as a gift?'\n      assign a7 = 'The Displate metal frame format is our best-selling gift: premium quality, guaranteed wow effect.'\n      assign q8 = 'Is the portrait made by a human or AI?'\n      assign a8 = 'Each portrait is created by hand by our designer specialized in pop culture. Zero AI filter.'\n      assign cta_text = 'Order my Wanted poster →'\n    else\n      assign faq_title = 'Tout savoir sur ton affiche Wanted One Piece personnalisée'\n      assign q1 = 'Puis-je choisir le nom et la prime affichés sur l&apos;affiche ?'\n      assign a1 = 'Oui, absolument. Tu peux personnaliser le nom, la prime (en berries) et la mention \"DEAD OR ALIVE\". Indique ces détails dans le champ de personnalisation lors de ta commande. Notre graphiste reproduira exactement ce que tu demandes.'\n      assign q2 = 'Puis-je mettre plusieurs personnes sur la même affiche Wanted ?'\n      assign a2 = 'Oui, sans problème ! Tu peux avoir jusqu&apos;à 3 personnes sur la même affiche. Il te suffit d&apos;ajouter une photo de chaque personne dans le champ de personnalisation. Parfait pour un cadeau de couple ou de famille fan de One Piece.'\n      assign q3 = 'Quelle photo envoyer pour un meilleur résultat ?'\n      assign a3 = 'Nous avons besoin d&apos;une photo nette où ton visage est bien visible, de face ou de 3/4. Évite les photos avec lunettes de soleil, masques, ou prise de très loin. Plus la photo est claire, plus la ressemblance sera forte.'\n      assign q4 = 'Puis-je choisir le style One Piece — Wano, Marine Ford, New World ?'\n      assign a4 = 'Oui ! Indique-nous le style souhaité dans le champ de personnalisation (Wano, Marine Ford, Time Skip, etc.) et notre graphiste s&apos;adapte. Tu peux aussi demander un fond spécifique, des couleurs particulières ou les symboles de ton équipage.'\n      assign q5 = 'Combien de temps pour recevoir mon aperçu ?'\n      assign a5 = 'L&apos;aperçu est livré sous 24–48 h ouvrées après ta commande. Tu reçois le rendu par e-mail et tu valides (ou demandes des retouches) avant que nous finalisions quoi que ce soit.'\n      assign q6 = 'Combien de retouches sont incluses ?'\n      assign a6 = 'Chez Artpixe, les retouches sont illimitées et incluses dans le prix. On ne s&apos;arrête pas tant que tu n&apos;es pas 100% satisfait. Aucun frais supplémentaire, aucune limite.'\n      assign q7 = 'Quel format choisir pour offrir l&apos;affiche en cadeau ?'\n      assign a7 = 'Le format Cadre Displate métal est notre plus offert : qualité premium, rendu élégant, effet waouh à l&apos;ouverture garanti. Le format Digital HD (19,90€) est idéal si tu veux imprimer toi-même ou envoyer par message.'\n      assign q8 = 'Le portrait est-il réalisé par un humain ou par une IA ?'\n      assign a8 = 'Chaque portrait est créé à la main par notre graphiste spécialisé en pop culture. Aucun filtre IA, aucun générateur — un vrai talent humain derrière chaque commande. C&apos;est pour ça que nos portraits ressemblent vraiment.'\n      assign cta_text = 'Commander mon affiche Wanted →'\n  endcase\n%}\n\n<!-- ✅ v3 : plus d'attributs microdata (itemscope/itemprop) sur les balises HTML -->\n<!-- ✅ Le schema FAQPage est uniquement dans le JSON-LD ci-dessous            -->\n\n<section style=\"padding:52px 20px;background:transparent;\">\n  <div style=\"max-width:760px;margin:0 auto;\">\n\n    <h2 style=\"font-family:'Bebas Neue',sans-serif;font-size:clamp(22px,4vw,36px);letter-spacing:.02em;color:#f0ede8;margin-bottom:28px;line-height:1.1;\">{{ faq_title }}</h2>\n\n    {% assign all_q = q1 | append: '|||' | append: q2 | append: '|||' | append: q3 | append: '|||' | append: q4 | append: '|||' | append: q5 | append: '|||' | append: q6 | append: '|||' | append: q7 | append: '|||' | append: q8 %}\n    {% assign all_a = a1 | append: '|||' | append: a2 | append: '|||' | append: a3 | append: '|||' | append: a4 | append: '|||' | append: a5 | append: '|||' | append: a6 | append: '|||' | append: a7 | append: '|||' | append: a8 %}\n    {% assign questions = all_q | split: '|||' %}\n    {% assign answers = all_a | split: '|||' %}\n\n    {%- for question in questions -%}\n      {%- assign answer = answers[forloop.index0] -%}\n      <div style=\"border-bottom:1px solid rgba(255,255,255,.07);\">\n        <details style=\"padding:0;\">\n          <summary style=\"list-style:none;display:flex;justify-content:space-between;align-items:center;padding:18px 4px;cursor:pointer;gap:14px;\">\n            <h3 style=\"font-size:15px;font-weight:500;color:#f0ede8;line-height:1.4;margin:0;\">{{ question }}</h3>\n            <span class=\"ap-arr\" style=\"color:#f5a623;font-size:22px;flex-shrink:0;transition:transform .2s;line-height:1;user-select:none;\" aria-hidden=\"true\">+</span>\n          </summary>\n          <div style=\"padding:0 4px 18px;\">\n            <p style=\"font-size:14px;color:#9a9690;line-height:1.75;margin:0;\">{{ answer }}</p>\n          </div>\n        </details>\n      </div>\n    {%- endfor -%}\n\n    <div style=\"text-align:center;margin-top:36px;\">\n      <a href=\"/products/portrait-personnalise-one-piece\" class=\"ap-faq-cta\" style=\"display:inline-block;background:#f5a623;color:#000;font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:.05em;padding:15px 44px;border-radius:99px;text-decoration:none;transition:background .2s;\" onmouseover=\"this.style.background='#e09520'\" onmouseout=\"this.style.background='#f5a623'\">{{ cta_text }}</a>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  details summary::-webkit-details-marker { display: none; }\n  details[open] .ap-arr { transform: rotate(45deg); }\n  details summary:focus { outline: none; }\n  @media(max-width:600px) {\n    .ap-faq-cta { font-size: 15px !important; padding: 13px 28px !important; letter-spacing: .03em !important; }\n  }\n</style>\n\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Puis-je choisir le nom et la prime affichés sur l'affiche ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oui, absolument. Tu peux personnaliser le nom, la prime (en berries) et la mention DEAD OR ALIVE. Indique ces détails dans le champ de personnalisation lors de ta commande.\"}},{\"@type\":\"Question\",\"name\":\"Puis-je mettre plusieurs personnes sur la même affiche Wanted ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oui, sans problème ! Tu peux avoir jusqu'à 3 personnes sur la même affiche. Il te suffit d'ajouter une photo de chaque personne. Parfait pour un cadeau de couple ou famille fan de One Piece.\"}},{\"@type\":\"Question\",\"name\":\"Quelle photo envoyer pour un meilleur résultat ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Une photo nette où ton visage est bien visible, de face ou de 3/4. Évite les photos avec lunettes de soleil, masques ou prise de très loin.\"}},{\"@type\":\"Question\",\"name\":\"Puis-je choisir le style One Piece — Wano, Marine Ford, New World ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oui ! Indique le style souhaité dans le champ de personnalisation et notre graphiste s'adapte.\"}},{\"@type\":\"Question\",\"name\":\"Combien de temps pour recevoir mon aperçu ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"L'aperçu est livré sous 24–48 h ouvrées après ta commande. Tu reçois le rendu par e-mail et tu valides avant que nous finalisions quoi que ce soit.\"}},{\"@type\":\"Question\",\"name\":\"Combien de retouches sont incluses ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Les retouches sont illimitées et incluses dans le prix. On ne s'arrête pas tant que tu n'es pas 100% satisfait.\"}},{\"@type\":\"Question\",\"name\":\"Quel format choisir pour offrir l'affiche en cadeau ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Le format Cadre Displate métal est notre plus offert : qualité premium, rendu élégant, effet waouh à l'ouverture garanti.\"}},{\"@type\":\"Question\",\"name\":\"Le portrait est-il réalisé par un humain ou par une IA ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Chaque portrait est créé à la main par notre graphiste spécialisé en pop culture. Aucun filtre IA, aucun générateur — un vrai talent humain derrière chaque commande.\"}}]}</script>",
