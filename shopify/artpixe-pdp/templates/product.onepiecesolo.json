            "custom_liquid": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600&display=swap');\n\n.aliv-wrap { padding: 0; }\n.aliv-inner { width: 100%; }\n.aliv-banner {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  padding: 13px 20px;\n  border: 1.5px dashed rgba(245,166,35,.45);\n  border-radius: 10px;\n  background: rgba(245,166,35,.06);\n}\n.aliv-icon { font-size: 16px; flex-shrink: 0; line-height: 1; }\n.aliv-text {\n  font-family: 'DM Sans', sans-serif;\n  font-size: 13px;\n  font-weight: 500;\n  color: #f0ede8;\n  line-height: 1.3;\n}\n.aliv-text strong { color: #f5a623; font-weight: 700; }\n@media (max-width: 480px) {\n  .aliv-banner { padding: 11px 14px; gap: 8px; }\n  .aliv-text { font-size: 12px; }\n}\n</style>\n\n{% assign lang = localization.language.iso_code | default: request.locale.iso_code | default: 'fr' %}\n\n<div class=\"aliv-wrap\">\n  <div class=\"aliv-inner\">\n    <div class=\"aliv-banner\">\n      <span class=\"aliv-icon\">🎁</span>\n      <span class=\"aliv-text\" id=\"alivText\"></span>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var lang = '{{ lang }}';\n  var d = new Date();\n  d.setDate(d.getDate() + 1);\n  var day = d.getDate();\n  var m   = d.getMonth();\n\n  var mois = {\n    fr: ['jan','fév','mar','avr','mai','juin','juil','août','sep','oct','nov','déc'],\n    en: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],\n    es: ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'],\n    de: ['Jan.','Feb.','März','Apr.','Mai','Juni','Juli','Aug.','Sep.','Okt.','Nov.','Dez.'],\n    it: ['gen','feb','mar','apr','mag','giu','lug','ago','set','ott','nov','dic']\n  };\n\n  var months = mois[lang] || mois['fr'];\n\n  var dateStr = {\n    fr: day + '\\u00a0' + months[m],\n    en: months[m] + '\\u00a0' + day,\n    es: day + '\\u00a0de\\u00a0' + months[m],\n    de: day + '.\\u00a0' + months[m],\n    it: day + '\\u00a0' + months[m]\n  }[lang] || (day + '\\u00a0' + months[m]);\n\n  var templates = {\n    fr: 'Commande avant le <strong>' + dateStr + '</strong> pour la <strong>LIVRAISON OFFERTE\\u00a0!</strong>',\n    en: 'Order before <strong>' + dateStr + '</strong> for <strong>FREE DELIVERY!</strong>',\n    es: 'Pide antes del <strong>' + dateStr + '</strong> para el <strong>ENV\\u00cdO GRATIS!</strong>',\n    de: 'Bestelle vor dem <strong>' + dateStr + '</strong> f\\u00fcr <strong>KOSTENLOSE LIEFERUNG!</strong>',\n    it: 'Ordina entro il <strong>' + dateStr + '</strong> per la <strong>SPEDIZIONE GRATUITA!</strong>'\n  };\n\n  document.getElementById('alivText').innerHTML = templates[lang] || templates['fr'];\n})();\n</script>"
