            "custom_liquid": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap');\n\n.avc-section {\n  padding: 40px 16px;\n  background: transparent;\n}\n.avc-inner { max-width: 1100px; margin: 0 auto; }\n\n.avc-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 4px;\n  gap: 10px;\n}\n.avc-title {\n  font-family: 'DM Sans', sans-serif;\n  font-size: 14px;\n  font-weight: 500;\n  color: #9a9690;\n  line-height: 1;\n}\n.avc-arrows { display: flex; gap: 6px; }\n.avc-arrow {\n  width: 28px; height: 28px;\n  border-radius: 50%;\n  border: 1px solid rgba(255,255,255,.12);\n  background: transparent;\n  color: #9a9690;\n  font-size: 13px;\n  cursor: pointer;\n  display: flex; align-items: center; justify-content: center;\n  box-shadow: none;\n  transition: border-color .15s, color .15s;\n}\n.avc-arrow:hover { border-color: #f5a623; color: #f5a623; }\n\n.avc-track-wrap { overflow: hidden; margin-top: 12px; }\n.avc-track {\n  display: flex;\n  gap: 8px;\n  transition: transform .4s cubic-bezier(.25,.46,.45,.94);\n}\n\n/* Desktop: 5 cartes · Tablette: 4 · Mobile: 2.3 */\n.avc-card {\n  flex: 0 0 calc((100% - 32px) / 5);\n  background: #141416;\n  border: 1px solid rgba(255,255,255,.07);\n  border-radius: 10px;\n  overflow: hidden;\n  cursor: pointer;\n  transition: transform .2s, border-color .2s;\n}\n.avc-card:hover {\n  transform: translateY(-2px);\n  border-color: rgba(245,166,35,.22);\n}\n.avc-img-wrap {\n  position: relative;\n  aspect-ratio: 1 / 1;\n  overflow: hidden;\n  background: #1a1a1d;\n}\n.avc-img-wrap img {\n  width: 100%; height: 100%;\n  object-fit: cover;\n  display: block;\n  transition: transform .3s ease;\n}\n.avc-card:hover .avc-img-wrap img { transform: scale(1.04); }\n\n.avc-body { padding: 8px 10px 10px; }\n.avc-stars { color: #f5a623; font-size: 11px; letter-spacing: .5px; margin-bottom: 3px; }\n.avc-name {\n  font-family: 'DM Sans', sans-serif;\n  font-size: 12px; font-weight: 500;\n  color: #f0ede8;\n  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n}\n.avc-date {\n  font-family: 'DM Sans', sans-serif;\n  font-size: 10px;\n  color: #5a5855;\n  margin-top: 1px;\n}\n\n.avc-dots {\n  display: flex;\n  justify-content: center;\n  gap: 5px;\n  margin-top: 14px;\n}\n.avc-dot {\n  width: 5px; height: 5px;\n  border-radius: 50%;\n  background: rgba(255,255,255,.15);\n  cursor: pointer;\n  transition: background .2s, transform .2s;\n}\n.avc-dot.active { background: #f5a623; transform: scale(1.35); }\n\n/* Lightbox */\n.avc-lb {\n  display: none;\n  position: fixed; inset: 0; z-index: 9999;\n  background: rgba(0,0,0,.9);\n  align-items: center; justify-content: center;\n  padding: 16px;\n}\n.avc-lb.open { display: flex; }\n.avc-lb-box {\n  background: #141416;\n  border: 1px solid rgba(255,255,255,.1);\n  border-radius: 16px;\n  max-width: 420px; width: 100%;\n  overflow: hidden;\n  position: relative;\n  max-height: 90vh;\n  display: flex; flex-direction: column;\n}\n.avc-lb-img {\n  width: 100%;\n  max-height: 52vh;\n  object-fit: contain;\n  background: #0d0d0f;\n  display: block;\n}\n.avc-lb-content { padding: 16px 18px; overflow-y: auto; }\n.avc-lb-stars { color: #f5a623; font-size: 15px; margin-bottom: 8px; }\n.avc-lb-text {\n  font-family: 'DM Sans', sans-serif;\n  font-size: 13px; color: #f0ede8;\n  line-height: 1.65; margin-bottom: 10px;\n}\n.avc-lb-meta {\n  font-family: 'DM Sans', sans-serif;\n  font-size: 11px; color: #9a9690;\n  display: flex; align-items: center; gap: 5px;\n}\n.avc-lb-meta::before {\n  content: ''; display: inline-block;\n  width: 4px; height: 4px;\n  background: #f5a623; border-radius: 50%; flex-shrink: 0;\n}\n.avc-lb-close {\n  position: absolute; top: 8px; right: 8px;\n  width: 26px; height: 26px;\n  background: rgba(0,0,0,.6); border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n  cursor: pointer; font-size: 13px; color: #f0ede8;\n  border: none; box-shadow: none;\n  transition: background .15s;\n}\n.avc-lb-close:hover { background: rgba(245,166,35,.3); }\n\n@media (max-width: 900px) {\n  .avc-card { flex: 0 0 calc((100% - 24px) / 4); }\n}\n@media (max-width: 640px) {\n  .avc-card { flex: 0 0 calc((100% - 16px) / 2.3); }\n  .avc-section { padding: 32px 14px; }\n}\n@media (max-width: 380px) {\n  .avc-card { flex: 0 0 75%; }\n}\n</style>\n\n<div class=\"avc-section\">\n  <div class=\"avc-inner\">\n\n    <div class=\"avc-header\">\n      <div class=\"avc-title\">Ce que disent nos clients :</div>\n      <div class=\"avc-arrows\">\n        <button class=\"avc-arrow\" id=\"avcPrev\" aria-label=\"Précédent\">&#8592;</button>\n        <button class=\"avc-arrow\" id=\"avcNext\" aria-label=\"Suivant\">&#8594;</button>\n      </div>\n    </div>\n\n    <div class=\"avc-track-wrap\">\n      <div class=\"avc-track\" id=\"avcTrack\">\n\n        <div class=\"avc-card\" onclick=\"avcOpen('https://images.loox.io/uploads/2026/4/8/ZNjICcfVg.jpg','Rachel S.','Avr 2026','Une expérience magique du début à la fin ! L\\'équipe ultra disponible, réactive. La première proposition était déjà la bonne — mes cousins vont être aux anges !')\">\n          <div class=\"avc-img-wrap\"><img src=\"https://images.loox.io/uploads/2026/4/8/ZNjICcfVg.jpg\" alt=\"Avis portrait personnalisé Rachel S. Artpixe\" loading=\"lazy\"></div>\n          <div class=\"avc-body\">\n            <div class=\"avc-stars\">★★★★★</div>\n            <div class=\"avc-name\">Rachel S.</div>\n            <div class=\"avc-date\">Avr 2026</div>\n          </div>\n        </div>\n\n        <div class=\"avc-card\" onclick=\"avcOpen('https://images.loox.io/uploads/2026/1/2/yQDGXsUNUk.jpg','Loris M.','Jan 2026','Commande d\\'une affiche format avis de recherche One Piece. Très belle qualité et fidèle aux photos envoyées !')\">\n          <div class=\"avc-img-wrap\"><img src=\"https://images.loox.io/uploads/2026/1/2/yQDGXsUNUk.jpg\" alt=\"Avis portrait personnalisé Loris M. Artpixe\" loading=\"lazy\"></div>\n          <div class=\"avc-body\">\n            <div class=\"avc-stars\">★★★★</div>\n            <div class=\"avc-name\">Loris M.</div>\n            <div class=\"avc-date\">Jan 2026</div>\n          </div>\n        </div>\n\n        <div class=\"avc-card\" onclick=\"avcOpen('https://images.loox.io/uploads/2025/12/20/ogdyDGPoq.jpg','Milja M.','Déc 2025','Ma fille est ravie, très belle qualité.')\">\n          <div class=\"avc-img-wrap\"><img src=\"https://images.loox.io/uploads/2025/12/20/ogdyDGPoq.jpg\" alt=\"Avis portrait personnalisé Milja M. Artpixe\" loading=\"lazy\"></div>\n          <div class=\"avc-body\">\n            <div class=\"avc-stars\">★★★★★</div>\n            <div class=\"avc-name\">Milja M.</div>\n            <div class=\"avc-date\">Déc 2025</div>\n          </div>\n        </div>\n\n        <div class=\"avc-card\" onclick=\"avcOpen('https://images.loox.io/uploads/2025/9/19/dwIOIkFAZ.jpg','Valentine L.','Sep 2025','Magnifique portrait de mes 2 fils jumeaux. J\\'ai vu leurs yeux s\\'illuminer : \\\"c\\'est nous en fait, c\\'est trop génial !\\\" — j\\'étais émue. Félicitations pour votre beau travail !')\">\n          <div class=\"avc-img-wrap\"><img src=\"https://images.loox.io/uploads/2025/9/19/dwIOIkFAZ.jpg\" alt=\"Avis portrait personnalisé Valentine L. Artpixe\" loading=\"lazy\"></div>\n          <div class=\"avc-body\">\n            <div class=\"avc-stars\">★★★★★</div>\n            <div class=\"avc-name\">Valentine L.</div>\n            <div class=\"avc-date\">Sep 2025</div>\n          </div>\n        </div>\n\n        <div class=\"avc-card\" onclick=\"avcOpen('https://images.loox.io/uploads/2025/6/17/G885TyDfD.jpg','Stellia C.','Juin 2025','MA-GNI-FI-QUE ! Mon chéri a adoré — il pensait recevoir un poster mais c\\'était le portrait de notre fils. Surprise réussie ! Il en a déjà parlé à ses amis.')\">\n          <div class=\"avc-img-wrap\"><img src=\"https://images.loox.io/uploads/2025/6/17/G885TyDfD.jpg\" alt=\"Avis portrait personnalisé Stellia C. Artpixe\" loading=\"lazy\"></div>\n          <div class=\"avc-body\">\n            <div class=\"avc-stars\">★★★★★</div>\n            <div class=\"avc-name\">Stellia C.</div>\n            <div class=\"avc-date\">Juin 2025</div>\n          </div>\n        </div>\n\n        <div class=\"avc-card\" onclick=\"avcOpen('https://images.loox.io/uploads/2025/6/11/01ES5zJdV.jpg','Geoffrey L.','Juin 2025','Envoi soigné, joli rendu.')\">\n          <div class=\"avc-img-wrap\"><img src=\"https://images.loox.io/uploads/2025/6/11/01ES5zJdV.jpg\" alt=\"Avis portrait personnalisé Geoffrey L. Artpixe\" loading=\"lazy\"></div>\n          <div class=\"avc-body\">\n            <div class=\"avc-stars\">★★★★★</div>\n            <div class=\"avc-name\">Geoffrey L.</div>\n            <div class=\"avc-date\">Juin 2025</div>\n          </div>\n        </div>\n\n        <div class=\"avc-card\" onclick=\"avcOpen('https://images.loox.io/uploads/2024/11/17/msZ1swB-d.jpg','Mélissa B.','Nov 2024','Le Displate est magnifique et j\\'ai hâte de pouvoir l\\'offrir à ma meilleure amie pour Noël. Elle va être aux anges.')\">\n          <div class=\"avc-img-wrap\"><img src=\"https://images.loox.io/uploads/2024/11/17/msZ1swB-d.jpg\" alt=\"Avis portrait personnalisé Mélissa B. Artpixe\" loading=\"lazy\"></div>\n          <div class=\"avc-body\">\n            <div class=\"avc-stars\">★★★★★</div>\n            <div class=\"avc-name\">Mélissa B.</div>\n            <div class=\"avc-date\">Nov 2024</div>\n          </div>\n        </div>\n\n        <div class=\"avc-card\" onclick=\"avcOpen('https://images.loox.io/uploads/2024/6/6/J-NJkZ1mkI.jpg','Virginie A.','Juin 2024','Cadeau original, mon fils était ravi. Poster très bien fait.')\">\n          <div class=\"avc-img-wrap\"><img src=\"https://images.loox.io/uploads/2024/6/6/J-NJkZ1mkI.jpg\" alt=\"Avis portrait personnalisé Virginie A. Artpixe\" loading=\"lazy\"></div>\n          <div class=\"avc-body\">\n            <div class=\"avc-stars\">★★★★★</div>\n            <div class=\"avc-name\">Virginie A.</div>\n            <div class=\"avc-date\">Juin 2024</div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <div class=\"avc-dots\" id=\"avcDots\"></div>\n\n  </div>\n</div>\n\n<div class=\"avc-lb\" id=\"avcLb\" onclick=\"if(event.target===this)avcClose()\">\n  <div class=\"avc-lb-box\">\n    <button class=\"avc-lb-close\" onclick=\"avcClose()\">✕</button>\n    <img class=\"avc-lb-img\" id=\"avcLbImg\" src=\"\" alt=\"\">\n    <div class=\"avc-lb-content\">\n      <div class=\"avc-lb-stars\">★★★★★</div>\n      <div class=\"avc-lb-text\" id=\"avcLbText\"></div>\n      <div class=\"avc-lb-meta\" id=\"avcLbMeta\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var track = document.getElementById('avcTrack');\n  var dotsEl = document.getElementById('avcDots');\n  var cards  = track.querySelectorAll('.avc-card');\n  var total  = cards.length;\n  var cur    = 0;\n\n  function visibleCount(){\n    var w = track.parentElement.offsetWidth;\n    if(w <= 380) return 1;\n    if(w <= 640) return 2;\n    if(w <= 900) return 4;\n    return 5;\n  }\n  function maxIndex(){ return Math.max(0, total - visibleCount()); }\n  function cardW(){ return cards[0] ? cards[0].offsetWidth + 8 : 0; }\n\n  function goTo(i){\n    cur = Math.min(Math.max(i, 0), maxIndex());\n    track.style.transform = 'translateX(-' + (cur * cardW()) + 'px)';\n    dotsEl.querySelectorAll('.avc-dot').forEach(function(d,j){\n      d.classList.toggle('active', j === cur);\n    });\n  }\n\n  function buildDots(){\n    dotsEl.innerHTML = '';\n    var n = maxIndex() + 1;\n    for(var i = 0; i < n; i++){\n      var d = document.createElement('div');\n      d.className = 'avc-dot' + (i===0?' active':'');\n      d.setAttribute('data-i', i);\n      d.onclick = function(){ goTo(+this.getAttribute('data-i')); };\n      dotsEl.appendChild(d);\n    }\n  }\n\n  document.getElementById('avcPrev').onclick = function(){ goTo(cur-1); };\n  document.getElementById('avcNext').onclick = function(){ goTo(cur+1); };\n\n  buildDots();\n  window.addEventListener('resize', function(){ buildDots(); goTo(0); });\n\n  var sx = 0;\n  track.addEventListener('touchstart', function(e){ sx = e.touches[0].clientX; },{passive:true});\n  track.addEventListener('touchend',   function(e){\n    var dx = sx - e.changedTouches[0].clientX;\n    if(Math.abs(dx) > 36) goTo(cur + (dx > 0 ? 1 : -1));\n  },{passive:true});\n})();\n\nfunction avcOpen(img,name,date,text){\n  document.getElementById('avcLbImg').src = img;\n  document.getElementById('avcLbImg').alt = name+' — Artpixe';\n  document.getElementById('avcLbText').textContent = text;\n  document.getElementById('avcLbMeta').textContent = name+' · '+date+' · Achat vérifié';\n  document.getElementById('avcLb').classList.add('open');\n  document.body.style.overflow='hidden';\n}\nfunction avcClose(){\n  document.getElementById('avcLb').classList.remove('open');\n  document.body.style.overflow='';\n}\n</script>"
          }
        },
        "garanties": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n  ARTPIXE — Garanties & avantages — Custom Liquid Block — i18n 5 langues\n  Format compact — grille 2 colonnes mobile, pas de carousel\n{% endcomment %}\n\n{%- assign lang_raw = localization.language.iso_code | default: request.locale.iso_code | default: shop.locale -%}\n{%- assign lang = lang_raw | downcase | replace: '_', '-' | split: '-' | first -%}\n\n{%- case lang -%}\n  {%- when 'en' -%}\n    {%- assign t_badge  = \"Why Artpixe\" -%}\n    {%- assign t_title  = \"Your personalised One Piece poster — guaranteed quality\" -%}\n    {%- assign t1_top = \"222 verified 5★ reviews\" -%}\n    {%- assign t1_bot = \"2 532 portraits created\" -%}\n    {%- assign t2_top = \"Preview in 48h\" -%}\n    {%- assign t2_bot = \"Guaranteed business hours\" -%}\n    {%- assign t3_top = \"Unlimited revisions\" -%}\n    {%- assign t3_bot = \"Until you are 100% satisfied\" -%}\n    {%- assign t4_top = \"Perfect gift\" -%}\n    {%- assign t4_bot = \"Couple · Family · Friends\" -%}\n    {%- assign t5_top = \"Secure payment\" -%}\n    {%- assign t5_bot = \"Protected transactions\" -%}\n\n  {%- when 'es' -%}\n    {%- assign t_badge  = \"Por que Artpixe\" -%}\n    {%- assign t_title  = \"Tu cartel Wanted One Piece personalizado — calidad garantizada\" -%}\n    {%- assign t1_top = \"222 resenas 5★ verificadas\" -%}\n    {%- assign t1_bot = \"2 532 retratos creados\" -%}\n    {%- assign t2_top = \"Vista previa en 48 h\" -%}\n    {%- assign t2_bot = \"Garantizado en horas laborables\" -%}\n    {%- assign t3_top = \"Retoques ilimitados\" -%}\n    {%- assign t3_bot = \"Hasta tu aprobacion completa\" -%}\n    {%- assign t4_top = \"Regalo perfecto\" -%}\n    {%- assign t4_bot = \"Pareja · Familia · Amigos\" -%}\n    {%- assign t5_top = \"Pago seguro\" -%}\n    {%- assign t5_bot = \"Transacciones protegidas\" -%}\n\n  {%- when 'de' -%}\n    {%- assign t_badge  = \"Warum Artpixe\" -%}\n    {%- assign t_title  = \"Dein personalisiertes One Piece Wanted-Poster — garantierte Qualitat\" -%}\n    {%- assign t1_top = \"222 verifizierte 5★ Bewertungen\" -%}\n    {%- assign t1_bot = \"2 532 erstellte Portrats\" -%}\n    {%- assign t2_top = \"Vorschau in 48 Std.\" -%}\n    {%- assign t2_bot = \"Garantiert in Werkstagsstunden\" -%}\n    {%- assign t3_top = \"Unbegrenzte Korrekturen\" -%}\n    {%- assign t3_bot = \"Bis zur vollen Zufriedenheit\" -%}\n    {%- assign t4_top = \"Perfektes Geschenk\" -%}\n    {%- assign t4_bot = \"Paar · Familie · Freunde\" -%}\n    {%- assign t5_top = \"Sichere Zahlung\" -%}\n    {%- assign t5_bot = \"Geschutzte Transaktionen\" -%}\n\n  {%- when 'it' -%}\n    {%- assign t_badge  = \"Perche Artpixe\" -%}\n    {%- assign t_title  = \"Il tuo poster Wanted One Piece personalizzato — qualita garantita\" -%}\n    {%- assign t1_top = \"222 recensioni 5★ verificate\" -%}\n    {%- assign t1_bot = \"2 532 ritratti creati\" -%}\n    {%- assign t2_top = \"Anteprima in 48 ore\" -%}\n    {%- assign t2_bot = \"Garantita in ore lavorative\" -%}\n    {%- assign t3_top = \"Ritocchi illimitati\" -%}\n    {%- assign t3_bot = \"Fino alla tua piena soddisfazione\" -%}\n    {%- assign t4_top = \"Regalo perfetto\" -%}\n    {%- assign t4_bot = \"Coppia · Famiglia · Amici\" -%}\n    {%- assign t5_top = \"Pagamento sicuro\" -%}\n    {%- assign t5_bot = \"Transazioni protette\" -%}\n\n  {%- else -%}\n    {%- assign t_badge  = \"Pourquoi Artpixe\" -%}\n    {%- assign t_title  = \"Ton affiche Wanted One Piece personnalisée — qualité garantie\" -%}\n    {%- assign t1_top = \"222 avis 5★ vérifiés\" -%}\n    {%- assign t1_bot = \"2 532 portraits créés\" -%}\n    {%- assign t2_top = \"Aperçu sous 24–48 h ouvrées\" -%}\n    {%- assign t2_bot = \"Garanti en heures ouvrées\" -%}\n    {%- assign t3_top = \"Retouches illimitées\" -%}\n    {%- assign t3_bot = \"Jusqu'à ta validation complète\" -%}\n    {%- assign t4_top = \"Cadeau parfait\" -%}\n    {%- assign t4_bot = \"Couple · Famille · Amis\" -%}\n    {%- assign t5_top = \"Paiement sécurisé\" -%}\n    {%- assign t5_bot = \"Transactions protégées\" -%}\n{%- endcase -%}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n\n<section class=\"apx-guar\" aria-label=\"{{ t_badge }}\">\n  <div class=\"apx-guar__head\">\n    <span class=\"apx-guar__badge\">{{ t_badge }}</span>\n    <h2 class=\"apx-guar__title\">{{ t_title }}</h2>\n  </div>\n\n  <ul class=\"apx-guar__grid\">\n\n    <li class=\"apx-guar__item\">\n      <span class=\"apx-guar__ico apx-guar__ico--star\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" width=\"18\" height=\"18\"><path d=\"M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6L12 2Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>\n      </span>\n      <div class=\"apx-guar__txt\">\n        <div class=\"apx-guar__top\">{{ t1_top }}</div>\n        <div class=\"apx-guar__bot\">{{ t1_bot }}</div>\n      </div>\n    </li>\n\n    <li class=\"apx-guar__item\">\n      <span class=\"apx-guar__ico apx-guar__ico--clock\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" width=\"18\" height=\"18\"><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M12 7v5l3 3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </span>\n      <div class=\"apx-guar__txt\">\n        <div class=\"apx-guar__top\">{{ t2_top }}</div>\n        <div class=\"apx-guar__bot\">{{ t2_bot }}</div>\n      </div>\n    </li>\n\n    <li class=\"apx-guar__item\">\n      <span class=\"apx-guar__ico apx-guar__ico--edit\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" width=\"18\" height=\"18\"><path d=\"M4 20h4l10.5-10.5a2 2 0 0 0 0-2.8l-1.2-1.2a2 2 0 0 0-2.8 0L4 16v4Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><path d=\"M13.5 6.5l4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n      </span>\n      <div class=\"apx-guar__txt\">\n        <div class=\"apx-guar__top\">{{ t3_top }}</div>\n        <div class=\"apx-guar__bot\">{{ t3_bot }}</div>\n      </div>\n    </li>\n\n    <li class=\"apx-guar__item\">\n      <span class=\"apx-guar__ico apx-guar__ico--gift\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" width=\"18\" height=\"18\"><rect x=\"3\" y=\"9\" width=\"18\" height=\"13\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M21 9H3V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M12 5v17M12 5c0-1.7-2-3-2-3s0 2 2 3ZM12 5c0-1.7 2-3 2-3s0 2-2 3Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n      </span>\n      <div class=\"apx-guar__txt\">\n        <div class=\"apx-guar__top\">{{ t4_top }}</div>\n        <div class=\"apx-guar__bot\">{{ t4_bot }}</div>\n      </div>\n    </li>\n\n    <li class=\"apx-guar__item\">\n      <span class=\"apx-guar__ico apx-guar__ico--lock\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" width=\"18\" height=\"18\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"11\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M8 11V7a4 4 0 1 1 8 0v4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"16\" r=\"1.5\" fill=\"currentColor\"/></svg>\n      </span>\n      <div class=\"apx-guar__txt\">\n        <div class=\"apx-guar__top\">{{ t5_top }}</div>\n        <div class=\"apx-guar__bot\">{{ t5_bot }}</div>\n      </div>\n    </li>\n\n  </ul>\n</section>\n\n<style>\n  .apx-guar{\n    margin: 12px 0;\n    padding: 20px;\n    background: #141416;\n    border: 1px solid rgba(255,255,255,.07);\n    border-radius: 18px;\n    font-family: 'DM Sans', sans-serif;\n  }\n\n  /* Header */\n  .apx-guar__head{ margin-bottom: 16px; }\n  .apx-guar__badge{\n    display: inline-flex;\n    background: rgba(245,166,35,.08);\n    border: 1px solid rgba(245,166,35,.2);\n    color: #f5a623;\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    padding: 3px 10px;\n    border-radius: 99px;\n    margin-bottom: 8px;\n  }\n  .apx-guar__title{\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 20px;\n    letter-spacing: .02em;\n    color: #f0ede8;\n    line-height: 1.1;\n  }\n\n  /* Grille */\n  .apx-guar__grid{\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 8px;\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    align-items: stretch;\n  }\n\n  /* Carte */\n  .apx-guar__item{\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 12px 14px;\n    background: rgba(255,255,255,.03);\n    border: 1px solid rgba(255,255,255,.06);\n    border-radius: 12px;\n    min-height: 62px;\n  }\n\n  /* Icône */\n  .apx-guar__ico{\n    width: 36px;\n    height: 36px;\n    border-radius: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .apx-guar__ico--star { background: rgba(245,166,35,.12); color: #f5a623;  border: 1px solid rgba(245,166,35,.2); }\n  .apx-guar__ico--clock{ background: rgba(99,179,237,.1);  color: #63b3ed;  border: 1px solid rgba(99,179,237,.2); }\n  .apx-guar__ico--edit { background: rgba(154,214,117,.1); color: #9ad675;  border: 1px solid rgba(154,214,117,.2); }\n  .apx-guar__ico--gift { background: rgba(236,107,174,.1); color: #ec6bae;  border: 1px solid rgba(236,107,174,.2); }\n  .apx-guar__ico--lock { background: rgba(169,140,245,.1); color: #a98cf5;  border: 1px solid rgba(169,140,245,.2); }\n\n  /* Texte */\n  .apx-guar__txt{\n    flex: 1;\n    min-width: 0;\n  }\n  .apx-guar__top{\n    font-size: 12px;\n    font-weight: 600;\n    color: #f0ede8;\n    line-height: 1.3;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .apx-guar__bot{\n    font-size: 11px;\n    font-weight: 300;\n    color: #9a9690;\n    margin-top: 2px;\n    line-height: 1.3;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  /* 5e carte — pleine largeur */\n  .apx-guar__item:last-child:nth-child(odd){\n    grid-column: 1 / -1;\n  }\n  /* 5e carte pleine largeur : texte non tronqué */\n  .apx-guar__item:last-child:nth-child(odd) .apx-guar__top,\n  .apx-guar__item:last-child:nth-child(odd) .apx-guar__bot{\n    white-space: normal;\n  }\n\n  /* Mobile — 1 colonne */\n  @media(max-width: 560px){\n    .apx-guar__grid{ grid-template-columns: 1fr; }\n    .apx-guar__item:last-child:nth-child(odd){ grid-column: auto; }\n    .apx-guar__top, .apx-guar__bot{ white-space: normal; }\n  }\n</style>"
          }
        }
