      "settings": {
        "custom_liquid": "{% comment %}\n  ARTPIXE — Bloc maillage interne One Piece — i18n FR/EN/ES/DE/IT\n  Fichier : artpixe-hub-content-one-piece.liquid\n  Installer sur : /products/portrait-personnalise-one-piece\n  Position : EN DERNIER — apres artpixe-reco-one-piece.liquid\n{% endcomment %}\n\n{% assign lang = localization.language.iso_code | default: request.locale.iso_code | default: shop.locale %}\n\n{% comment %} === TEXTES GLOBAUX === {% endcomment %}\n{% if lang == 'en' %}\n  {% assign hub_tag         = \"One Piece Universe\" %}\n  {% assign hub_title       = \"Everything about\" %}\n  {% assign hub_badge_exclu = \"Exclusive guide\" %}\n  {% assign hub_badge_art   = \"Article\" %}\n  {% assign hub_badge_guide = \"Guide\" %}\n  {% assign hub_badge_actu  = \"News\" %}\n  {% assign hub_read        = \"Read the article\" %}\n{% elsif lang == 'de' %}\n  {% assign hub_tag         = \"One Piece Universum\" %}\n  {% assign hub_title       = \"Alles uber\" %}\n  {% assign hub_badge_exclu = \"Exklusiver Guide\" %}\n  {% assign hub_badge_art   = \"Artikel\" %}\n  {% assign hub_badge_guide = \"Guide\" %}\n  {% assign hub_badge_actu  = \"News\" %}\n  {% assign hub_read        = \"Artikel lesen\" %}\n{% elsif lang == 'es' %}\n  {% assign hub_tag         = \"Universo One Piece\" %}\n  {% assign hub_title       = \"Todo sobre\" %}\n  {% assign hub_badge_exclu = \"Guia exclusiva\" %}\n  {% assign hub_badge_art   = \"Articulo\" %}\n  {% assign hub_badge_guide = \"Guia\" %}\n  {% assign hub_badge_actu  = \"Noticias\" %}\n  {% assign hub_read        = \"Leer el articulo\" %}\n{% elsif lang == 'it' %}\n  {% assign hub_tag         = \"Universo One Piece\" %}\n  {% assign hub_title       = \"Tutto su\" %}\n  {% assign hub_badge_exclu = \"Guida esclusiva\" %}\n  {% assign hub_badge_art   = \"Articolo\" %}\n  {% assign hub_badge_guide = \"Guida\" %}\n  {% assign hub_badge_actu  = \"News\" %}\n  {% assign hub_read        = \"Leggi l'articolo\" %}\n{% else %}\n  {% assign hub_tag         = \"Univers One Piece\" %}\n  {% assign hub_title       = \"Tout savoir sur\" %}\n  {% assign hub_badge_exclu = \"Guide exclusif\" %}\n  {% assign hub_badge_art   = \"Article\" %}\n  {% assign hub_badge_guide = \"Guide\" %}\n  {% assign hub_badge_actu  = \"Actu\" %}\n  {% assign hub_read        = \"Lire l'article\" %}\n{% endif %}\n\n{% comment %} === CARD 1 — LP creer-son-affiche-wanted === {% endcomment %}\n{% if lang == 'en' %}\n  {% assign c1_title = \"Create Your One Piece Wanted Poster\" %}\n  {% assign c1_cta   = \"Create my poster\" %}\n{% elsif lang == 'de' %}\n  {% assign c1_title = \"Erstelle dein One Piece Wanted-Poster\" %}\n  {% assign c1_cta   = \"Mein Poster erstellen\" %}\n{% elsif lang == 'es' %}\n  {% assign c1_title = \"Crea tu Poster Wanted de One Piece\" %}\n  {% assign c1_cta   = \"Crear mi poster\" %}\n{% elsif lang == 'it' %}\n  {% assign c1_title = \"Crea il tuo Poster Wanted di One Piece\" %}\n  {% assign c1_cta   = \"Crea il mio poster\" %}\n{% else %}\n  {% assign c1_title = \"Creer ton affiche Wanted One Piece\" %}\n  {% assign c1_cta   = \"Creer mon affiche\" %}\n{% endif %}\n\n{% comment %} === CARD 2 — Personnages + primes === {% endcomment %}\n{% if lang == 'en' %}\n  {% assign c2_title = \"All One Piece Characters and Their Bounties\" %}\n  {% assign c2_cta   = \"See the characters\" %}\n{% elsif lang == 'de' %}\n  {% assign c2_title = \"Alle One Piece Charaktere und ihre Kopfgelder\" %}\n  {% assign c2_cta   = \"Charaktere ansehen\" %}\n{% elsif lang == 'es' %}\n  {% assign c2_title = \"Todos los personajes de One Piece y sus recompensas\" %}\n  {% assign c2_cta   = \"Ver los personajes\" %}\n{% elsif lang == 'it' %}\n  {% assign c2_title = \"Tutti i personaggi di One Piece e le loro taglie\" %}\n  {% assign c2_cta   = \"Vedi i personaggi\" %}\n{% else %}\n  {% assign c2_title = \"Tous les personnages One Piece et leurs primes\" %}\n  {% assign c2_cta   = \"Voir les personnages\" %}\n{% endif %}\n\n{% comment %} === CARD 3 — Blog creer-affiche-wanted === {% endcomment %}\n{% if lang == 'en' %}\n  {% assign c3_title = \"One Piece Wanted Poster — Everything You Need to Know\" %}\n{% elsif lang == 'de' %}\n  {% assign c3_title = \"One Piece Wanted-Poster — alles Wissenswerte\" %}\n{% elsif lang == 'es' %}\n  {% assign c3_title = \"Poster Wanted One Piece — todo lo que necesitas saber\" %}\n{% elsif lang == 'it' %}\n  {% assign c3_title = \"Poster Wanted One Piece — tutto quello che c'e da sapere\" %}\n{% else %}\n  {% assign c3_title = \"Affiche Wanted One Piece — tout ce qu'il faut savoir\" %}\n{% endif %}\n\n{% comment %} === CARD 4 — Eiichiro Oda === {% endcomment %}\n{% if lang == 'en' %}\n  {% assign c4_title = \"Who Is Eiichiro Oda, the Creator of One Piece?\" %}\n{% elsif lang == 'de' %}\n  {% assign c4_title = \"Wer ist Eiichiro Oda, der Schopfer von One Piece?\" %}\n{% elsif lang == 'es' %}\n  {% assign c4_title = \"Quien es Eiichiro Oda, el creador de One Piece?\" %}\n{% elsif lang == 'it' %}\n  {% assign c4_title = \"Chi e Eiichiro Oda, il creatore di One Piece?\" %}\n{% else %}\n  {% assign c4_title = \"Qui est Eiichiro Oda, le createur de One Piece ?\" %}\n{% endif %}\n\n{% comment %} === CARD 5 — Egghead / Oda pause === {% endcomment %}\n{% if lang == 'en' %}\n  {% assign c5_title = \"Egghead Arc and Oda's Return — What Changes\" %}\n{% elsif lang == 'de' %}\n  {% assign c5_title = \"Egghead-Arc und Odas Ruckkehr — was sich andert\" %}\n{% elsif lang == 'es' %}\n  {% assign c5_title = \"Arco Egghead y regreso de Oda — lo que cambia\" %}\n{% elsif lang == 'it' %}\n  {% assign c5_title = \"Arco Egghead e ritorno di Oda — cosa cambia\" %}\n{% else %}\n  {% assign c5_title = \"Arc Egghead et retour d'Oda — ce que ca change\" %}\n{% endif %}\n\n{% comment %} === CARD 6 — Moku Moku no Mi === {% endcomment %}\n{% if lang == 'en' %}\n  {% assign c6_title = \"Moku Moku no Mi — Smoker's Devil Fruit\" %}\n{% elsif lang == 'de' %}\n  {% assign c6_title = \"Moku Moku no Mi — Smokers Teufelsfrucht\" %}\n{% elsif lang == 'es' %}\n  {% assign c6_title = \"Moku Moku no Mi — el fruto del diablo de Smoker\" %}\n{% elsif lang == 'it' %}\n  {% assign c6_title = \"Moku Moku no Mi — il frutto del diavolo di Smoker\" %}\n{% else %}\n  {% assign c6_title = \"Moku Moku no Mi — le fruit du demon de Smoker\" %}\n{% endif %}\n\n{% comment %} === CSS === {% endcomment %}\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap');\n.op-hub{padding:36px 20px;max-width:1100px;margin:0 auto;font-family:'DM Sans',sans-serif;}\n.op-hub-head{display:flex;align-items:center;gap:12px;margin-bottom:16px;}\n.op-hub-tag{display:inline-flex;align-items:center;gap:5px;background:rgba(245,166,35,.08);border:1px solid rgba(245,166,35,.18);color:#f5a623;font-size:10px;font-weight:600;padding:4px 10px;border-radius:99px;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;}\n.op-hub-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:.02em;line-height:1;color:#f0ede8;margin:0;}\n.op-hub-title span{color:#f5a623;}\n.op-hub-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}\n@media(max-width:760px){.op-hub-grid{grid-template-columns:1fr 1fr;}}\n@media(max-width:480px){.op-hub-grid{grid-template-columns:1fr;}}\n.op-hub-card{background:#141416;border:1px solid rgba(255,255,255,.07);border-radius:12px;padding:14px 16px;text-decoration:none;display:flex;flex-direction:column;gap:6px;transition:border-color .2s,transform .15s;position:relative;overflow:hidden;}\n.op-hub-card:hover{border-color:rgba(245,166,35,.35);transform:translateY(-2px);}\n.op-hub-card.op-hub-lp{border-color:rgba(245,166,35,.3);background:linear-gradient(135deg,#141416,#1a1610);}\n.op-hub-card.op-hub-lp::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,#f5a623,rgba(245,166,35,0));}\n.op-hub-badge{display:inline-flex;align-items:center;font-size:9px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:2px 7px;border-radius:99px;width:fit-content;}\n.badge-article{background:rgba(92,166,232,.1);color:#5ca6e8;border:1px solid rgba(92,166,232,.2);}\n.badge-guide{background:rgba(245,166,35,.1);color:#f5a623;border:1px solid rgba(245,166,35,.2);}\n.badge-lp{background:rgba(245,166,35,.15);color:#f5a623;border:1px solid rgba(245,166,35,.3);}\n.badge-actu{background:rgba(76,184,122,.1);color:#4cb87a;border:1px solid rgba(76,184,122,.2);}\n.op-hub-card-title{font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:.02em;color:#f0ede8;line-height:1.15;}\n.op-hub-card.op-hub-lp .op-hub-card-title{color:#f5a623;}\n.op-hub-arrow{display:flex;align-items:center;justify-content:space-between;margin-top:2px;}\n.op-hub-arrow-txt{font-size:11px;color:#5a5855;font-weight:500;transition:color .2s;}\n.op-hub-card:hover .op-hub-arrow-txt{color:#f5a623;}\n.op-hub-divider{border-top:1px solid rgba(255,255,255,.07);margin-bottom:32px;}\n</style>\n\n{% comment %} === HTML === {% endcomment %}\n<div class=\"op-hub-divider\"></div>\n\n<div class=\"op-hub\">\n  <div class=\"op-hub-head\">\n    <div class=\"op-hub-tag\">🏴‍☠️ {{ hub_tag }}</div>\n    <h2 class=\"op-hub-title\">{{ hub_title }} <span>One Piece</span></h2>\n  </div>\n\n  <div class=\"op-hub-grid\">\n\n    <a href=\"/pages/creer-son-affiche-wanted-one-piece-personnalisee-artpixe\" class=\"op-hub-card op-hub-lp\">\n      <div class=\"op-hub-badge badge-lp\">⭐ {{ hub_badge_exclu }}</div>\n      <div class=\"op-hub-card-title\">{{ c1_title }}</div>\n      <div class=\"op-hub-arrow\"><span class=\"op-hub-arrow-txt\">{{ c1_cta }} →</span></div>\n    </a>\n\n    <a href=\"/blogs/toute-lactualite-concernant-les-mangas-et-les-animes/la-liste-de-tous-les-personnages-one-piece-artpixe\" class=\"op-hub-card\">\n      <div class=\"op-hub-badge badge-article\">{{ hub_badge_art }}</div>\n      <div class=\"op-hub-card-title\">{{ c2_title }}</div>\n      <div class=\"op-hub-arrow\"><span class=\"op-hub-arrow-txt\">{{ c2_cta }} →</span></div>\n    </a>\n\n    <a href=\"/blogs/toute-lactualite-concernant-les-mangas-et-les-animes/creer-affiche-wanted-one-piece\" class=\"op-hub-card\">\n      <div class=\"op-hub-badge badge-guide\">{{ hub_badge_guide }}</div>\n      <div class=\"op-hub-card-title\">{{ c3_title }}</div>\n      <div class=\"op-hub-arrow\"><span class=\"op-hub-arrow-txt\">{{ hub_read }} →</span></div>\n    </a>\n\n    <a href=\"/blogs/toute-lactualite-concernant-les-mangas-et-les-animes/qui-est-eiichiro-oda-le-mysterieux-mangaka-derriere-one-piece\" class=\"op-hub-card\">\n      <div class=\"op-hub-badge badge-article\">{{ hub_badge_art }}</div>\n      <div class=\"op-hub-card-title\">{{ c4_title }}</div>\n      <div class=\"op-hub-arrow\"><span class=\"op-hub-arrow-txt\">{{ hub_read }} →</span></div>\n    </a>\n\n    <a href=\"/blogs/toute-lactualite-concernant-les-mangas-et-les-animes/oda-pause-egghead-one-piece-artpixe\" class=\"op-hub-card\">\n      <div class=\"op-hub-badge badge-actu\">{{ hub_badge_actu }}</div>\n      <div class=\"op-hub-card-title\">{{ c5_title }}</div>\n      <div class=\"op-hub-arrow\"><span class=\"op-hub-arrow-txt\">{{ hub_read }} →</span></div>\n    </a>\n\n    <a href=\"/blogs/toute-lactualite-concernant-les-mangas-et-les-animes/moku-moku-no-mi-decouverte-du-fruit-du-demon-one-piece\" class=\"op-hub-card\">\n      <div class=\"op-hub-badge badge-article\">{{ hub_badge_art }}</div>\n      <div class=\"op-hub-card-title\">{{ c6_title }}</div>\n      <div class=\"op-hub-arrow\"><span class=\"op-hub-arrow-txt\">{{ hub_read }} →</span></div>\n    </a>\n\n  </div>\n</div>",
