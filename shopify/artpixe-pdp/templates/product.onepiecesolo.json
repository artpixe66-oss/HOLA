      "settings": {
        "custom_liquid": "{% comment %}\n  ARTPIXE — Comment ça marche — Custom Liquid Block\n  DA Artpixe : #0d0d0f · #f5a623 · Bebas Neue + DM Sans\n  SEO : H2 keyword-rich · H3 steps · schema.org HowTo\n  Mobile : carousel scroll-snap + dots\n  i18n : FR · EN · ES · DE · IT\n  v3.1 : ancres CTA optimisées SEO\n{% endcomment %}\n\n{%- assign lang_raw = localization.language.iso_code | default: request.locale.iso_code | default: shop.locale -%}\n{%- assign lang = lang_raw | downcase | replace: '_', '-' | split: '-' | first -%}\n\n{%- case lang -%}\n  {%- when 'en' -%}\n    {%- assign t_badge    = \"Simple process\" -%}\n    {%- assign t_title    = \"How to create your personalised One Piece Wanted poster?\" -%}\n    {%- assign t_sub      = \"4 steps. Preview in 48h, unlimited revisions included.\" -%}\n    {%- assign t_s1_h     = \"1. Choose your style\" -%}\n    {%- assign t_s1_p     = \"Select One Piece universe, your character and background (Wano, New World, Marine Ford…).\" -%}\n    {%- assign t_s2_h     = \"2. Send your photo\" -%}\n    {%- assign t_s2_p     = \"A clear front-facing photo. Alone or with several people on the same poster.\" -%}\n    {%- assign t_s3_h     = \"3. A designer creates your portrait\" -%}\n    {%- assign t_s3_p     = \"A human digital designer draws your portrait by hand — no AI, no automatic filter.\" -%}\n    {%- assign t_s4_h     = \"4. Preview & approve\" -%}\n    {%- assign t_s4_p     = \"Preview within 48 business hours. Unlimited revisions until you are 100% satisfied.\" -%}\n    {%- assign t_cta      = \"Order my personalised One Piece Wanted poster →\" -%}\n    {%- assign t_trust1   = \"Unlimited revisions\" -%}\n    {%- assign t_trust2   = \"Support 7 days/week\" -%}\n    {%- assign t_trust3   = \"Preview in 48h\" -%}\n    {%- assign t_schema_name = \"How to create a personalised One Piece Wanted poster\" -%}\n    {%- assign t_schema_desc = \"Order a personalised One Piece Wanted poster from Artpixe in 4 simple steps.\" -%}\n\n  {%- when 'es' -%}\n    {%- assign t_badge    = \"Proceso simple\" -%}\n    {%- assign t_title    = \"Como crear tu cartel Wanted One Piece personalizado?\" -%}\n    {%- assign t_sub      = \"4 pasos. Vista previa en 48h, retoques ilimitados incluidos.\" -%}\n    {%- assign t_s1_h     = \"1. Elige tu estilo\" -%}\n    {%- assign t_s1_p     = \"Selecciona el universo One Piece, tu personaje y fondo (Wano, New World, Marineford…).\" -%}\n    {%- assign t_s2_h     = \"2. Envia tu foto\" -%}\n    {%- assign t_s2_p     = \"Una foto clara de frente. Solo/a o con varias personas en el mismo cartel.\" -%}\n    {%- assign t_s3_h     = \"3. Un disenador crea tu retrato\" -%}\n    {%- assign t_s3_p     = \"Un disenador grafico digital humano dibuja tu retrato a mano. Sin IA ni filtros.\" -%}\n    {%- assign t_s4_h     = \"4. Vista previa y aprobacion\" -%}\n    {%- assign t_s4_p     = \"Vista previa en 48h laborables. Retoques ilimitados hasta tu aprobacion completa.\" -%}\n    {%- assign t_cta      = \"Pedir mi cartel Wanted One Piece personalizado →\" -%}\n    {%- assign t_trust1   = \"Retoques ilimitados\" -%}\n    {%- assign t_trust2   = \"Soporte 7 dias/7\" -%}\n    {%- assign t_trust3   = \"Vista previa en 48h\" -%}\n    {%- assign t_schema_name = \"Como crear un cartel Wanted One Piece personalizado\" -%}\n    {%- assign t_schema_desc = \"Encarga tu cartel Wanted One Piece personalizado en Artpixe en 4 pasos.\" -%}\n\n  {%- when 'de' -%}\n    {%- assign t_badge    = \"Einfacher Ablauf\" -%}\n    {%- assign t_title    = \"Wie erstelle ich mein personalisiertes One Piece Wanted-Poster?\" -%}\n    {%- assign t_sub      = \"4 Schritte. Vorschau in 48 Std., unbegrenzte Korrekturen inklusive.\" -%}\n    {%- assign t_s1_h     = \"1. Stil waehlen\" -%}\n    {%- assign t_s1_p     = \"Waehle das One Piece-Universum, deinen Charakter und Hintergrund (Wano, New World…).\" -%}\n    {%- assign t_s2_h     = \"2. Foto einsenden\" -%}\n    {%- assign t_s2_p     = \"Ein klares Frontfoto. Allein oder mit mehreren Personen auf demselben Poster.\" -%}\n    {%- assign t_s3_h     = \"3. Ein Designer erstellt dein Portrait\" -%}\n    {%- assign t_s3_p     = \"Ein menschlicher digitaler Grafiker zeichnet dein Portrait per Hand. Keine KI, keine Filter.\" -%}\n    {%- assign t_s4_h     = \"4. Vorschau und Freigabe\" -%}\n    {%- assign t_s4_p     = \"Vorschau in 48 Werkstagsstunden. Unbegrenzte Korrekturen bis zur vollen Zufriedenheit.\" -%}\n    {%- assign t_cta      = \"Mein Wanted One Piece Poster jetzt bestellen →\" -%}\n    {%- assign t_trust1   = \"Korrekturen inklusive\" -%}\n    {%- assign t_trust2   = \"Support 7 Tage/Woche\" -%}\n    {%- assign t_trust3   = \"Vorschau in 48h\" -%}\n    {%- assign t_schema_name = \"Wie erstelle ich ein personalisiertes One Piece Wanted-Poster\" -%}\n    {%- assign t_schema_desc = \"Bestelle dein personalisiertes One Piece Wanted-Poster bei Artpixe in 4 Schritten.\" -%}\n\n  {%- when 'it' -%}\n    {%- assign t_badge    = \"Processo semplice\" -%}\n    {%- assign t_title    = \"Come creare il tuo poster Wanted One Piece personalizzato?\" -%}\n    {%- assign t_sub      = \"4 passaggi. Anteprima in 48 ore, ritocchi illimitati inclusi.\" -%}\n    {%- assign t_s1_h     = \"1. Scegli lo stile\" -%}\n    {%- assign t_s1_p     = \"Seleziona universo One Piece, personaggio e sfondo (Wano, New World, Marineford…).\" -%}\n    {%- assign t_s2_h     = \"2. Invia la tua foto\" -%}\n    {%- assign t_s2_p     = \"Una foto frontale e nitida. Da solo/a o con piu persone sullo stesso poster.\" -%}\n    {%- assign t_s3_h     = \"3. Un designer crea il tuo ritratto\" -%}\n    {%- assign t_s3_p     = \"Un grafico digitale umano disegna il tuo ritratto a mano. Nessuna IA, nessun filtro.\" -%}\n    {%- assign t_s4_h     = \"4. Anteprima e approvazione\" -%}\n    {%- assign t_s4_p     = \"Anteprima entro 48 ore lavorative. Ritocchi illimitati fino alla tua piena soddisfazione.\" -%}\n    {%- assign t_cta      = \"Ordina il mio poster Wanted One Piece personalizzato →\" -%}\n    {%- assign t_trust1   = \"Ritocchi illimitati\" -%}\n    {%- assign t_trust2   = \"Supporto 7 giorni su 7\" -%}\n    {%- assign t_trust3   = \"Anteprima in 48h\" -%}\n    {%- assign t_schema_name = \"Come creare un poster Wanted One Piece personalizzato\" -%}\n    {%- assign t_schema_desc = \"Ordina il tuo poster Wanted One Piece personalizzato su Artpixe in 4 passaggi.\" -%}\n\n  {%- else -%}\n    {%- assign t_badge    = \"Processus simple\" -%}\n    {%- assign t_title    = \"Comment créer ton affiche Wanted One Piece personnalisée ?\" -%}\n    {%- assign t_sub      = \"4 étapes. Aperçu sous 24–48 h ouvrées, retouches illimitées incluses.\" -%}\n    {%- assign t_s1_h     = \"1. Choisis ton style\" -%}\n    {%- assign t_s1_p     = \"Sélectionne l'univers One Piece, ton personnage et ton décor (Wano, New World, Marine Ford…).\" -%}\n    {%- assign t_s2_h     = \"2. Envoie ta photo\" -%}\n    {%- assign t_s2_p     = \"Une photo nette de face. Seul(e) ou à plusieurs sur la même affiche.\" -%}\n    {%- assign t_s3_h     = \"3. Un graphiste crée ton portrait\" -%}\n    {%- assign t_s3_p     = \"Un graphiste numérique humain dessine ton portrait à la main. Zéro IA, zéro filtre.\" -%}\n    {%- assign t_s4_h     = \"4. Aperçu et validation\" -%}\n    {%- assign t_s4_p     = \"Aperçu sous 24–48 h ouvrées. Retouches illimitées jusqu'à ta validation complète.\" -%}\n    {%- assign t_cta      = \"Commander mon affiche Wanted One Piece personnalisée →\" -%}\n    {%- assign t_trust1   = \"Retouches illimitées\" -%}\n    {%- assign t_trust2   = \"Support 7j/7\" -%}\n    {%- assign t_trust3   = \"Aperçu sous 24–48 h ouvrées\" -%}\n    {%- assign t_schema_name = \"Comment créer une affiche Wanted One Piece personnalisée\" -%}\n    {%- assign t_schema_desc = \"Commandez votre affiche Wanted One Piece personnalisée sur Artpixe en 4 étapes simples.\" -%}\n{%- endcase -%}\n\n{% comment %} ————— SCHEMA.ORG HowTo ————— {% endcomment %}\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"HowTo\",\n  \"name\": \"{{ t_schema_name }}\",\n  \"description\": \"{{ t_schema_desc }}\",\n  \"totalTime\": \"PT48H\",\n  \"estimatedCost\": { \"@type\": \"MonetaryAmount\", \"currency\": \"EUR\", \"value\": \"19.90\" },\n  \"step\": [\n    { \"@type\": \"HowToStep\", \"position\": 1, \"name\": \"{{ t_s1_h }}\", \"text\": \"{{ t_s1_p }}\" },\n    { \"@type\": \"HowToStep\", \"position\": 2, \"name\": \"{{ t_s2_h }}\", \"text\": \"{{ t_s2_p }}\" },\n    { \"@type\": \"HowToStep\", \"position\": 3, \"name\": \"{{ t_s3_h }}\", \"text\": \"{{ t_s3_p }}\" },\n    { \"@type\": \"HowToStep\", \"position\": 4, \"name\": \"{{ t_s4_h }}\", \"text\": \"{{ t_s4_p }}\" }\n  ]\n}\n</script>\n\n<link href=\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n\n{% comment %} ————— HTML ————— {% endcomment %}\n<section class=\"apx-how\" id=\"apx-how\">\n  <div class=\"apx-how__inner\">\n\n    <div class=\"apx-how__head\">\n      <span class=\"apx-how__badge\">{{ t_badge }}</span>\n      <h2 class=\"apx-how__title\">{{ t_title }}</h2>\n      <p class=\"apx-how__sub\">{{ t_sub }}</p>\n    </div>\n\n    <div class=\"apx-how__track\" id=\"apx-track\" role=\"list\">\n\n      <div class=\"apx-step apx-reveal\" role=\"listitem\">\n        <div class=\"apx-step__icon apx-step__icon--1\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" width=\"36\" height=\"36\">\n            <path d=\"M12 2l1.2 4.2L17.4 8 13.2 9.2 12 13.5 10.8 9.2 6.6 8l4.2-1.8L12 2Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M5 13l.7 2.5L8 16l-2.3 1 .7 2.5L5 18l-1.4 1.5.7-2.5L2 16l2.3-.5L5 13Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M18 12l.8 2.8L22 16l-3.2 1.2.8 2.8L18 18.3 16.6 20l.8-2.8L14 16l3.2-.8L18 12Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n          </svg>\n        </div>\n        <h3 class=\"apx-step__h\">{{ t_s1_h }}</h3>\n        <p class=\"apx-step__p\">{{ t_s1_p }}</p>\n      </div>\n\n      <div class=\"apx-step apx-reveal\" role=\"listitem\">\n        <div class=\"apx-step__icon apx-step__icon--2\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" width=\"36\" height=\"36\">\n            <path d=\"M7 8h10a2 2 0 0 1 2 2v9H5v-9a2 2 0 0 1 2-2Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M9 8l1-2h4l1 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M12 12.2a2.6 2.6 0 1 0 0 5.2 2.6 2.6 0 0 0 0-5.2Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n            <path d=\"M16.8 6.7l.9.9\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </div>\n        <h3 class=\"apx-step__h\">{{ t_s2_h }}</h3>\n        <p class=\"apx-step__p\">{{ t_s2_p }}</p>\n      </div>\n\n      <div class=\"apx-step apx-reveal\" role=\"listitem\">\n        <div class=\"apx-step__icon apx-step__icon--3\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" width=\"36\" height=\"36\">\n            <path d=\"M4 20h4l10.5-10.5a2 2 0 0 0 0-3L16.5 4a2 2 0 0 0-3 0L3 14.5V20Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M12.5 5.5l6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <path d=\"M9 19h6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </div>\n        <h3 class=\"apx-step__h\">{{ t_s3_h }}</h3>\n        <p class=\"apx-step__p\">{{ t_s3_p }}</p>\n      </div>\n\n      <div class=\"apx-step apx-reveal\" role=\"listitem\">\n        <div class=\"apx-step__icon apx-step__icon--4\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" width=\"36\" height=\"36\">\n            <path d=\"M5 4h14v16H5V4Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M8 8h8v8H8V8Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M11 11.2a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n          </svg>\n        </div>\n        <h3 class=\"apx-step__h\">{{ t_s4_h }}</h3>\n        <p class=\"apx-step__p\">{{ t_s4_p }}</p>\n      </div>\n\n    </div>\n\n    <!-- Dots (mobile) -->\n    <div class=\"apx-dots\" id=\"apx-dots\" aria-hidden=\"true\">\n      <button class=\"apx-dot-btn active\" data-idx=\"0\"></button>\n      <button class=\"apx-dot-btn\" data-idx=\"1\"></button>\n      <button class=\"apx-dot-btn\" data-idx=\"2\"></button>\n      <button class=\"apx-dot-btn\" data-idx=\"3\"></button>\n    </div>\n\n    <!-- CTA -->\n    <div class=\"apx-how__cta apx-reveal\">\n      <a class=\"apx-how__btn\" href=\"/pages/creer-affiche-wanted-one-piece\">{{ t_cta }}</a>\n      <div class=\"apx-how__trust\">\n        <span class=\"apx-trust-dot\"></span>{{ t_trust1 }}\n        <span class=\"apx-trust-dot\"></span>{{ t_trust2 }}\n        <span class=\"apx-trust-dot\"></span>{{ t_trust3 }}\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  /* ── BASE ── */\n  .apx-how{\n    padding: 72px 20px;\n    background: transparent;\n    font-family: 'DM Sans', sans-serif;\n    overflow: hidden;\n  }\n  .apx-how__inner{ max-width: 1100px; margin: 0 auto; }\n\n  /* ── HEADER ── */\n  .apx-how__head{ text-align: center; margin-bottom: 40px; }\n  .apx-how__badge{\n    display: inline-flex;\n    background: rgba(245,166,35,.1);\n    border: 1px solid rgba(245,166,35,.25);\n    color: #f5a623;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    padding: 5px 14px;\n    border-radius: 99px;\n    margin-bottom: 14px;\n  }\n  .apx-how__title{\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: clamp(26px, 3.2vw, 44px);\n    letter-spacing: .02em;\n    line-height: 1.05;\n    color: #f0ede8;\n    margin: 0 0 10px;\n  }\n  .apx-how__sub{\n    color: #9a9690;\n    font-size: 15px;\n    font-weight: 300;\n    margin: 0;\n  }\n\n  /* ── GRID desktop ── */\n  .apx-how__track{\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n  }\n\n  /* ── CARTE ── */\n  .apx-step{\n    text-align: center;\n    padding: 28px 18px 24px;\n    background: #141416;\n    border: 1px solid rgba(255,255,255,.07);\n    border-radius: 16px;\n    transition: border-color .25s, transform .25s;\n  }\n  .apx-step:hover{\n    border-color: rgba(245,166,35,.25);\n    transform: translateY(-5px);\n  }\n\n  /* ── ICÔNE ── */\n  .apx-step__icon{\n    width: 80px;\n    height: 80px;\n    border-radius: 999px;\n    margin: 0 auto 16px;\n    display: grid;\n    place-items: center;\n    position: relative;\n  }\n  .apx-step__icon::after{\n    content: \"\";\n    position: absolute;\n    inset: -1px;\n    border-radius: 999px;\n    background: radial-gradient(circle at 30% 20%, rgba(255,255,255,.15), transparent 55%);\n    pointer-events: none;\n  }\n  .apx-step__icon--1{ background: rgba(245,166,35,.12); border: 1px solid rgba(245,166,35,.2); color: #f5a623; }\n  .apx-step__icon--2{ background: rgba(99,179,237,.1);  border: 1px solid rgba(99,179,237,.2);  color: #63b3ed; }\n  .apx-step__icon--3{ background: rgba(154,214,117,.1); border: 1px solid rgba(154,214,117,.2); color: #9ad675; }\n  .apx-step__icon--4{ background: rgba(169,140,245,.1); border: 1px solid rgba(169,140,245,.2); color: #a98cf5; }\n\n  /* ── TEXTE ── */\n  .apx-step__h{\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 20px;\n    letter-spacing: .03em;\n    color: #f0ede8;\n    margin: 0 0 8px;\n  }\n  .apx-step__p{\n    font-size: 13px;\n    font-weight: 300;\n    color: #9a9690;\n    line-height: 1.6;\n    margin: 0;\n  }\n\n  /* ── DOTS (cachés desktop) ── */\n  .apx-dots{ display: none; }\n\n  /* ── CTA ── */\n  .apx-how__cta{ text-align: center; margin-top: 40px; }\n  .apx-how__btn{\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 15px 36px;\n    border-radius: 99px;\n    background: #f5a623;\n    color: #000;\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 18px;\n    letter-spacing: .06em;\n    text-decoration: none;\n    transition: background .2s, transform .2s, box-shadow .2s;\n    box-shadow: 0 8px 24px rgba(245,166,35,.25);\n  }\n  .apx-how__btn:hover{\n    background: #fff;\n    transform: translateY(-2px);\n    box-shadow: 0 12px 32px rgba(255,255,255,.15);\n  }\n  .apx-how__btn:active{ transform: translateY(0); opacity: .92; }\n\n  .apx-how__trust{\n    margin-top: 14px;\n    color: #9a9690;\n    font-size: 13px;\n    font-weight: 300;\n  }\n  .apx-trust-dot{\n    display: inline-block;\n    width: 4px; height: 4px;\n    border-radius: 999px;\n    background: rgba(245,166,35,.5);\n    margin: 0 10px;\n    transform: translateY(-2px);\n  }\n\n  /* ── REVEAL ── */\n  .apx-reveal{ opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }\n  .apx-reveal.is-visible{ opacity: 1; transform: translateY(0); }\n\n  /* ══ MOBILE carousel ══ */\n  @media(max-width: 760px){\n    .apx-how{ padding: 52px 0; }\n    .apx-how__inner{ padding: 0; }\n    .apx-how__head{ padding: 0 20px; }\n\n    .apx-how__track{\n      display: flex;\n      overflow-x: scroll;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n      gap: 0;\n      padding: 4px 0 16px;\n    }\n    .apx-how__track::-webkit-scrollbar{ display: none; }\n\n    .apx-step{\n      flex: 0 0 calc(100vw - 64px);\n      max-width: 300px;\n      scroll-snap-align: center;\n      margin: 0 10px;\n      transform: none !important;\n    }\n    .apx-step:first-child{ margin-left: calc((100vw - (100vw - 64px)) / 2); }\n    .apx-step:last-child { margin-right: calc((100vw - (100vw - 64px)) / 2); }\n    .apx-step.is-active{ border-color: rgba(245,166,35,.3); background: rgba(245,166,35,.04); }\n\n    .apx-dots{\n      display: flex;\n      justify-content: center;\n      gap: 8px;\n      margin: 4px 0 20px;\n    }\n    .apx-dot-btn{\n      width: 8px; height: 8px;\n      border-radius: 99px;\n      border: none;\n      background: rgba(255,255,255,.2);\n      padding: 0; cursor: pointer;\n      transition: background .2s, width .2s;\n    }\n    .apx-dot-btn.active{ background: #f5a623; width: 22px; }\n\n    .apx-how__cta{ padding: 0 20px; }\n    .apx-how__btn{\n      width: auto;\n      font-size: 14px;\n      padding: 12px 24px;\n      letter-spacing: .04em;\n      background: transparent;\n      color: #f5a623;\n      border: 1px solid rgba(245,166,35,.4);\n      box-shadow: none;\n    }\n    .apx-how__btn:hover{\n      background: rgba(245,166,35,.08);\n      color: #f5a623;\n      box-shadow: none;\n    }\n  }\n\n  @media(prefers-reduced-motion: reduce){\n    .apx-step, .apx-how__btn, .apx-reveal{ transition: none !important; }\n  }\n</style>\n\n<script>\n(function(){\n  var section = document.getElementById('apx-how');\n  if(!section || section.dataset.apxInit === '1') return;\n  section.dataset.apxInit = '1';\n\n  /* Reveal */\n  var revealEls = section.querySelectorAll('.apx-reveal');\n  if(revealEls.length){\n    var io = new IntersectionObserver(function(entries){\n      entries.forEach(function(e){\n        if(e.isIntersecting){ e.target.classList.add('is-visible'); io.unobserve(e.target); }\n      });\n    },{ threshold: 0.15 });\n    revealEls.forEach(function(el, i){ el.style.transitionDelay = (i * 70) + 'ms'; io.observe(el); });\n  }\n\n  /* Carousel dots */\n  var track = document.getElementById('apx-track');\n  var dots  = document.querySelectorAll('#apx-dots .apx-dot-btn');\n  var cards = track ? track.querySelectorAll('.apx-step') : [];\n  if(!track || !dots.length || !cards.length) return;\n\n  function onScroll(){\n    var idx = Math.round(track.scrollLeft / (track.scrollWidth / cards.length));\n    idx = Math.max(0, Math.min(idx, cards.length - 1));\n    dots.forEach(function(d, i){ d.classList.toggle('active', i === idx); });\n    cards.forEach(function(c, i){ c.classList.toggle('is-active', i === idx); });\n  }\n\n  dots.forEach(function(dot){\n    dot.addEventListener('click', function(){\n      var card = cards[parseInt(this.dataset.idx, 10)];\n      if(card) track.scrollTo({ left: card.offsetLeft - (track.offsetWidth - card.offsetWidth) / 2, behavior: 'smooth' });\n    });\n  });\n\n  track.addEventListener('scroll', onScroll, { passive: true });\n  onScroll();\n})();\n</script>",
